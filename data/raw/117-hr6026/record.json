 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-11-18",
   "text": "Keep Food Containers Safe from PFAS Act of 2021\n This bill prohibits food packaging that contains intentionally added PFAS (i.e., a perfluoroalkyl substance or a polyfluoroalkyl substance that is man-made with at least one fully fluorinated carbon atom)."
  }
