 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-09-14",
   "text": "Fair Credit Full Disclosure Act - Amends the Fair Credit Reporting Act to require a consumer reporting agency, on request, to disclose to the consumer all information in the consumer's file, including credit scores or any other risk scores or predictors relating to the consumer. (Current law requires file disclosure, but prohibits construing the requirement to require disclosure of credit or risk scores.)"
  }
 ],
