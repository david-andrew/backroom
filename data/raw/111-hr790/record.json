 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-02-02",
   "text": "Georges Bank Preservation Act - Prohibits the issuance of any lease or other authorization by the federal government for exploration, development, or production of oil or natural gas in: (1) any marine national monument or national marine sanctuary; or (2) the fishing grounds known as Georges Bank in the waters of the United States."
  }
