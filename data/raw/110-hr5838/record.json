 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2008-04-17",
   "text": "Teaching and Research Assistant Collective Bargaining Rights Act - Amends the National Labor Relations Act to provide collective bargaining rights for students enrolled at a private institution of higher education who perform work for remuneration at the institution's direction, regardless of whether the work relates to their courses of study (teaching and research assistants)."
  }
