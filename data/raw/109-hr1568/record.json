 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2005-04-12",
   "text": "Amends the Internal Revenue Code to: (1) reduce the top marginal tax rate for estates and gifts to 30 percent; (2) increase the estate tax exclusion amount to $10 million, with an annual adjustment for inflation; and (3) increase the annual gift tax exclusion from $10,000 to $50,000."
  }
