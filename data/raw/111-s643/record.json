 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2009-03-19",
   "text": "Children's Health Protection Act of 2009 - Amends the Employee Retirement Income Security Act of 1974 (ERISA), the Public Health Service Act, and the Internal Revenue Code to prohibit a group health plan from imposing any preexisting condition exclusion for individuals who have not attained 25 years of age. \n Applies such requirement to coverage offered in the individual market."
  }
