 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-05-27",
   "text": "Harold Hughes-Bill Emerson Substance Abuse Treatment Parity Act of 1999 - Amends the Public Health Service Act, the Employee Retirement Income Security Act of 1974, and the Internal Revenue Code to provide for parity in the application of treatment limitations and financial requirements to substance abuse treatment benefits under group health plans and individual health insurance coverage."
  }
