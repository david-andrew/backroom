 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2021-01-28",
   "text": "End Taxpayer Subsidies for Drug Ads Act\n This bill prohibits a tax deduction for expenses relating to direct-to-consumer advertising of prescription drugs. \n Direct-to-consumer advertising is any dissemination, by or on behalf of a sponsor of a prescription drug product, of an advertisement that is in regard to the drug product and primarily targeted to the general public."
  }
 ],
