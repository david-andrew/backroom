 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-03-23",
   "text": "CLEANER Act of 2021 or the Closing Loopholes and Ending Arbitrary and Needless Evasion of Regulations Act of 2021\n This bill eliminates the exemption of waste associated with the exploration, development, or production of crude oil, natural gas, or geothermal energy from regulations governing the disposal of hazardous waste.\n Within a year of enactment, the Environmental Protection Agency (EPA) must\n determine whether such waste meets the criteria for hazardous waste,\n promulgate regulations concerning the disposal of such waste if the EPA determines it is hazardous, and \n revise regulations applicable to solid waste management and disposal facilities (e.g., landfills) to address such waste that is nonhazardous."
  }
 ],
