 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-10-24",
   "text": "Court Legal Access and Student Support Act of 2023 or the CLASS Act of 2023\n This bill prohibits institutions of higher education (IHEs) that participate in federal student aid programs from restricting students' ability to pursue claims against IHEs in court. In addition, the bill makes mandatory arbitration agreements inapplicable to enrollment agreements between students and IHEs."
  }
 ],
