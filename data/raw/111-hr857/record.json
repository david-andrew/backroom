 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-02-04",
   "text": "Limit Executive Compensation Abuse Act - Limits the annual compensation of any employee of a financial institution or other entity that receives funds under the Troubled Asset Relief Program (TARP) established under the Emergency Economic Stabilization Act of 2008 to the amount of compensation paid to the President of the United States."
  }
