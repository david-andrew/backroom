 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-04-11",
   "text": "Fair Credit Reporting Amendments of 1991 - Amends the Fair Credit Reporting Act to require consumer reporting agencies to disclose promptly to a consumer any adverse information the agency receives. Directs the Board of Governors of the Federal Reserve System to prescribe regulations defining \"adverse information.\""
  }
