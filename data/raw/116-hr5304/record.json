 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-12-04",
   "text": "PBM Transparency in Prescription Drug Costs Act\n This bill requires group health plans or the pharmacy benefits manager (PBM) for the plans to periodically report certain prescription drug pricing and utilization data; it also requires PBMs to pass on to health plans all rebates and discounts received from drug manufacturers."
  }
