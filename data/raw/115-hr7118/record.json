 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2018-11-06",
   "text": "Excessive Use of Force Prevention Act of 2018\n This bill amends the federal criminal code specify that the application of any pressure to the throat or windpipe which may prevent or hinder breathing or reduce intake of air (i.e., a chokehold) constitutes the deprivation of rights under color of law."
  }
