   "actionTime": "14:23:02",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The chair appointed conferees: Dingell, Waxman, Wyden, Lent, and Madigan.",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H40100",
   "actionDate": "1990-10-17",
   "actionTime": "14:22:13",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Mr. Waxman asked unanimous consent that the House disagree to the Senate amendment, and agree to a conference.",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H41610",
   "actionDate": "1990-10-17",
   "actionTime": "14:22:13",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "On motion that the House disagree to the Senate amendment, and agree to a conference Agreed to without objection.",
   "type": "ResolvingDifferences"
  },
  {
   "actionDate": "1990-10-15",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Message on Senate action sent to the House.",
   "type": "Floor"
  },
  {
   "actionDate": "1990-10-12",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Senate insists on its amendments, asks for a conference, appoints conferees Kennedy; Pell; Metzenbaum; Dodd; Hatch; Durenberger; Coats.",
   "type": "ResolvingDifferences"
  },
  {
   "actionDate": "1990-10-12",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Passed Senate in lieu of S. 3006 with an amendment by Voice Vote.",
   "type": "Floor"
  },
  {
   "actionCode": "17000",
   "actionDate": "1990-10-12",
   "sourceSystem": {
    "code": 9,
    "name": "Library of Congress"
   },
   "text": "Passed/agreed to in Senate: Passed Senate in lieu of S. 3006 with an amendment by Voice Vote.",
   "type": "Floor"
  },
  {
   "actionDate": "1990-10-12",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Senate struck all after the Enacting Clause and substituted the language of S. 3006 amended.",
   "type": "Floor"
  },
  {
   "actionDate": "1990-10-12",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Measure laid before Senate by unanimous consent.",
   "type": "Floor"
  },
