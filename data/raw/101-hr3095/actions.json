   },
   "text": "Mr. Whittaker demanded a second on the motion to suspend the rules and agree to the conference report. Without objection a second is ordered.",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H40200",
   "actionDate": "1990-10-27",
   "actionTime": "00:10:16",
   "sourceSystem": {
    "code": 2,
