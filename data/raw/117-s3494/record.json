 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2022-01-12",
   "text": "Ban Congressional Stock Trading Act\n This bill requires each Member of Congress to divest or place in a blind trust any specified investment owned by the Member, the Member's spouse, or a dependent of the Member. This requirement applies for the entire period of a Member's service in Congress and for 180 days after that service ceases.\n A Member of Congress who does not comply with the bill's requirements is subject to a fine equal to the Member's monthly congressional salary. The fine must be assessed 30 days after notice of the violation is issued and at least every subsequent 30 days."
  }
 ],
