 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-05-13",
   "text": "Market Process Restoration Act of 1999 - Repeals: (1) the Sherman Act; (2) the Clayton Act; (3) the Antitrust Civil Process Act; (4) the International Antitrust Enforcement Assistance Act of 1994; and (5) provisions of the Federal Trade Commission Act declaring unfair methods of competition in or affecting commerce to be unlawful."
  }
