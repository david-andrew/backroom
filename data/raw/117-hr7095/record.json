 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-03-16",
   "text": "Accountable Federal Employees Act or the Accountable Feds Act\n This bill establishes and modifies requirements relating to the administration of the federal workforce, including (1) creating a new Schedule F in the excepted service for certain positions that are not normally subject to change as a result of a presidential transition; (2) specifying certain standards and principles relating to removals, grievance procedures, and adverse personnel actions; (3) placing certain restrictions on the use of union time; and (4) creating a workgroup to manage the efficiency of labor-management relations."
  }
 ],
