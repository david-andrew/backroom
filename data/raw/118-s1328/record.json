 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-04-27",
   "text": "Tribal Labor Sovereignty Act of 2023\n This bill excludes Indian tribes and tribal enterprises and institutions on tribal land from requirements for employers under the National Labor Relations Act (NLRA). (Currently under the NLRA, employers may not engage in unfair labor practices and must allow employees to form unions, engage in collective bargaining, and take collective action.)"
  }
 ],
