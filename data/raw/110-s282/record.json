 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2007-01-12",
   "text": "College Student Relief Act of 2007 - Amends the Higher Education Act of 1965 to phase-in cuts in the interest rate charged undergraduate student borrowers of subsidized loans under the Federal Family Education Loan (FFEL) program, thereby reducing such rate from 6.8% in July 2006 to 3.4% in July 2011."
  }
