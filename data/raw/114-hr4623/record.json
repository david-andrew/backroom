 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2016-02-25",
   "text": "Right to Rent Act of 2016\n This bill grants eligible mortgagors subject to foreclosure proceedings the right to continue to occupy foreclosed properties subject to the payment of fair market rent for a period of five years that begins upon the commencement of occupancy of such property. \n The Department of Housing and Urban Development shall: (1) monitor compliance with this Act, (2) provide assistance to eligible mortgagors in exercising their rights under this Act, and (3) conduct outreach activities to inform eligible mortgagors of this Act."
  }
