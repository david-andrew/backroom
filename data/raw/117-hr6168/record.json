 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-12-07",
   "text": "Future Generations Protection Act\n This bill prohibits (1) the emission of any greenhouse gas in any quantity from a new electric utility steam generating unit (i.e., certain power plants); (2) hydraulic fracturing on all onshore and offshore land in the United States; and (3) exports of domestically produced crude oil and natural gas, with specified exceptions."
  }
 ],
