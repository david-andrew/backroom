 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2007-08-03",
   "text": "Great Lakes Pollution Prevention Act of 2007 - Amends the Federal Water Pollution Control Act to prohibit either the Administrator of the Environmental Protection Agency (EPA) or any Great Lakes state from issuing a permit for the discharge of a pollutant into a body of water that is part of the Great Lakes, or that is within the boundaries of two or more of such states, without the concurrence of all such states. Authorizes a state to concur only after providing notice in the vicinity of the portion of the body of water within its boundaries and an opportunity for public comment."
  }
 ],
