 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-01-31",
   "text": "Fair Labor Standards Amendments of 1995 - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage to: (1) $4.25 an hour during the period ending six months after the date of enactment of this Act; (2) $4.50 an hour during the succeeding year; (3) $4.75 during the succeeding year; (4) $5.00 during the succeeding year; and (5) $5.25 thereafter."
  }
 ],
