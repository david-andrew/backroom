 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-05-07",
   "text": "Honest Ads Act\n This bill applies requirements, limitations, and protections regarding political advertising in traditional media to internet or digital political advertising. The bill sets forth special rules for disclosure statements for certain internet or digital ads.\n Each television or radio station, provider of cable or satellite television, or online platform must ensure that the political advertising it hosts is not directly or indirectly purchased by a foreign national.\n Online platforms must publish a record of requests to purchase political advertising."
  }
 ],
