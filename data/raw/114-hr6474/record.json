 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2016-12-07",
   "text": "This bill eliminates the Federal Communications Commission's broadcast/newspaper cross-ownership ban, which prohibits a single entity, or parties under common control, from owning a daily newspaper and a full-power commercial broadcast station (AM, FM, or television) in the same market."
  }
