 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-07-20",
   "text": "Prohibits the Secretary of the Interior from engaging in any leasing activity with respect to specified submerged lands of the Outer Continental Shelf off the State of Florida. Directs the Secretary to promulgate guidelines for the United States to follow when buying back any existing oil or gas lease on such lands."
  }
