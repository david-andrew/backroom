 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1994-08-11",
   "text": "Baseball Fans Protection Act of 1994 - Amends the Clayton Act to apply the antitrust laws of the United States to any unilateral term or condition (excluding a strike or a lockout) that is imposed by a party that is subject to the agreement between the major league baseball owners and the players' union."
  }
