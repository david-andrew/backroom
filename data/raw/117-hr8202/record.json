 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-06-23",
   "text": "Preventing Vape Use Act\n This bill requires electronic nicotine delivery systems (e.g., e-cigarettes and vape pens) to successfully undergo Food and Drug Administration (FDA) premarket review before being introduced into interstate commerce for commercial distribution. It also requires the FDA to order a mandatory recall of any such systems that have not successfully undergone premarket review."
  }
 ],
