 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2007-01-04",
   "text": "Fair Minimum Wage Act of 2007 - Amends the Fair Labor Standards Act of 1938 to increase the federal minimum wage to: (1) $5.85 an hour, beginning on the 60th day after enactment of this Act; (2) $6.55 an hour, beginning 12 months after that 60th day; and (3) $7.25 an hour, beginning 24 months after that 60th day.\n Applies federal minimum wage requirements to the Commonwealth of the Northern Mariana Islands. Sets forth a transition period during which a specified minimum wage in the Commonwealth shall be gradually increased to equal the federal minimum wage."
  }
 ],
