 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1989-03-09",
   "text": "Radiation Victims Fair Treatment Act - Repeals the provision in the Department of Defense Authorization Act, 1985 which: (1) substitutes the United States as defendant in all suits against private contractors for radiation injuries arising from atomic weapons testing programs; and (2) makes the Federal Tort Claims Act the sole remedy for those injuries. Details the applicability of statutes of limitations."
  }
 ],
