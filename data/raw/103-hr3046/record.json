 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-09-09",
   "text": "Physician Ownership and Referral Act of 1993 - Amends the Public Health Service Act to prohibit a physician from making a referral to an entity providing a health service if the physician (or an immediate family member) has a financial relationship with the entity. Defines financial relationship. Sets forth exceptions. Provides for sanctions for violators."
  }
 ],
