 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-01-30",
   "text": "Amends the Federal Election Campaign Act of 1971 (FECA) to prohibit any person from expending any funds for the purpose of influencing any campaign for election for Federal office unless the funds are subject to the FECA limitations, prohibitions, and reporting requirements applicable to contributions and expenditures under the Act (thus banning soft money)."
  }
