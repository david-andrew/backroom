 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-02-03",
   "text": "Amends the Internal Revenue Code to reduce the individual and corporate capital gains rate from 28 percent and 34 percent to 15 percent. Reduces the minimum tax rate accordingly. Reduces such tax to 7.5 percent for low- and middle-income taxpayers. Requires indexing, based on the gross national product deflator, of the adjusted basis of certain assets (corporate stock and tangible property that is a capital asset of property used in a trade or business) that have been held for more than one year at the time of sale or other transfer, solely for the purpose of determining gain or loss."
  }
 ],
