 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1999-01-19",
   "text": "Fair Minimum Wage Act of 1999 - Amends the Fair Labor Standards Act of 1938 to increase the Federal minimum wage (currently $5.15 per hour) to: (1) $5.65 an hour during the year beginning on September 1, 1999; and (2) $6.15 an hour beginning on September 1, 2000. Makes Federal minimum requirements applicable to the Commonwealth of the Northern Mariana Islands."
  }
 ],
