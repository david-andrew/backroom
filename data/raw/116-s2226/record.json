 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-07-23",
   "text": "Redistricting Reform Act of 2019\n This bill requires that congressional redistricting be conducted in accordance with a plan developed by (1) a state-established independent commission; or (2) if such a commission fails to enact a plan, a three-judge panel from a U.S. District Court."
  }
