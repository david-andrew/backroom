 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-04-18",
   "text": "Amends the Internal Revenue Code to disallow an income tax deduction for business expenses incurred as removal or liability costs resulting from a spill or other discharge of oil being transported by or for the taxpayer from a vessel onto waters subject to the Clean Water Act. Excludes discharges caused by an act of God, an act of war, negligence on the part of the U.S. Government, or an act or omission of a third party. Applies this deduction denial retroactively with respect to amounts incurred in taxable years 1989 and thereafter."
  }
 ],
