 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2011-10-04",
   "text": "Consumer Mobile Fairness Act of 2011 - Renders invalid or unenforceable any pre-dispute arbitration agreement between an individual and a provider of commercial mobile service or mobile broadband Internet access service. Defines a \"pre-dispute arbitration agreement\" as an agreement to arbitrate a dispute that has not yet arisen at the time of the making of such agreement."
  }
 ],
