 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-04-26",
   "text": "Medical Debt Responsibility Act of 2013 - Amends the Fair Credit Reporting Act to prohibit a consumer reporting agency from making any report containing information related to a fully paid or settled medical debt that had been characterized as delinquent, charged off, or in collection which, from the date of payment or settlement, antedates the report by more than 45 days."
  }
