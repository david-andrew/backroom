 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2023-06-12",
   "text": "Stop Arctic Ocean Drilling Act of 2023\n This bill prohibits the Department of the Interior from issuing or renewing a lease or any other authorization for the exploration, development, or production of oil, natural gas, or any other mineral in the Arctic Ocean, including the Beaufort Sea and Chukchi Sea Planning Areas."
  }
