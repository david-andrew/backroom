 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-08-02",
   "text": "America Wins Act \n This bill imposes an excise tax on the carbon dioxide content of coal, petroleum and petroleum products, and natural gas sold by the manufacturer, producer, or importer and requires the revenues to be used for infrastructure, an energy refund program to provide payments to certain low-income households, and other purposes."
  }
