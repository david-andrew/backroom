 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2023-03-14",
   "text": "Salary Transparency Act\n This bill requires employers to disclose the wage or wage range in the public or internal posting of an employment opportunity. This includes the range of wages or salaries and other forms of compensation reasonably expected to be offered for the employment opportunity.\n Violations of these requirement are subject to civil penalties, statutory or actual damages, and injunctive relief as appropriate."
  }
 ],
