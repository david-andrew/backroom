 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-02-05",
   "text": "Fair Access for Safe and Timely Generics Act of 2019 or the FAST Generics Act of 2019\n This bill generally prohibits the license holder of a drug or biological product approved by the Food and Drug Administration from restricting availability of the drug or product for testing by a product developer seeking to develop a drug, generic drug, or biosimilar."
  }
