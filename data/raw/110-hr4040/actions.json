    }
   ],
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "On motion that the House instruct conferees Agreed to by the Yeas and Nays: 405 - 0 (Roll no. 320). (consideration: CR H3855-3856)",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H41400",
   "actionDate": "2008-05-14",
   "actionTime": "18:43:48",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The previous question was ordered without objection. (consideration: CR H3855)",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H8D000",
   "actionDate": "2008-05-14",
   "actionTime": "18:38:42",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The House proceeded with one hour of debate on the Whitfield motion to instruct conferees on H.R. 4040. The instructions contained in the motion seek to require the managers on the part of the House be instructed to insist upon the provisions contained in the House bill.",
   "type": "Floor"
  },
  {
   "actionCode": "H40150",
   "actionDate": "2008-05-14",
   "actionTime": "18:38:27",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Mr. Whitfield (KY) moved that the House instruct conferees. (consideration: CR H3854; text: CR H3854)",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H41610",
   "actionDate": "2008-05-14",
   "actionTime": "18:37:42",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "On motion that the House disagree to the Senate amendment, and agree to a conference Agreed to without objection.",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H40150",
   "actionDate": "2008-05-14",
   "actionTime": "18:37:14",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Mr. Dingell moved that the House disagree to the Senate amendment, and agree to a conference. (consideration: CR H3854-3856)",
   "type": "ResolvingDifferences"
  },
