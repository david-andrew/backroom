 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2025-01-16",
   "text": "Federal Adjustment of Income Rates Act or the FAIR Act\nThis bill modifies pay rates for federal employees in 2026. Specifically, the bill increases rates under the statutory pay systems and for prevailing rate employees by 3.3% and increases locality pay by 1%."
  }
