 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1999-10-15",
   "text": "Amends the Packers and Stockyards Act, 1921 to make it unlawful for a packer to own, feed, or control livestock intended for slaughter, with exceptions for: (1) a cooperative whose majority membership owns, feeds, or controls the livestock that the cooperative slaughters; or (2) a packer, owned or controlled by producers of a type of livestock, that slaughters less than two percent of such livestock slaughtered annually in the United States."
  }
 ],
