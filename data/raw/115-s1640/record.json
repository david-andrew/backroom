 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2017-07-26",
   "text": "Fair Elections Now Act\n This bill establishes the Fair Elections Fund, which shall provide funding to Senate candidates who meet specified conditions and agree to abide by certain requirements, such as limits on types of campaign funding sources and a minimum number of appearances in public debates. The bill also (1) revises provisions related to broadcasts of Senate campaign advertisements, (2) provides a tax credit for individuals who make certain types of Senate campaign contributions, and (3) imposes a tax on certain U.S. government contracts."
  }
 ],
