 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1995-06-29",
   "text": "Fairness in Federal Contracting Act of 1995 - Prohibits the use of funds, under any appropriations Act for FY 1995, for any executive order, or other rule, regulation, or order, that affects the ability of Federal contractors, subcontractors, or vendors to hire permanent replacements for lawfully striking employees."
  }
