 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2003-05-07",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act, or the COAST Anti-Drilling Act - Amends Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil, natural gas, or any other mineral in either the Mid-Atlantic planning area or the North Atlantic planning area."
  }
 ],
