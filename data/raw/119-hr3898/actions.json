  },
  {
   "actionCode": "H32400",
   "actionDate": "2025-12-11",
   "actionTime": "11:24:39",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The Speaker designated the Honorable Addison P. McDowell to act as Chairman of the Committee.",
   "type": "Floor"
  },
  {
   "actionCode": "H32020",
   "actionDate": "2025-12-11",
   "actionTime": "11:24:38",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "House resolved itself into the Committee of the Whole House on the state of the Union pursuant to H. Res. 936 and Rule XVIII.",
   "type": "Floor"
  },
  {
   "actionCode": "H8D000",
   "actionDate": "2025-12-11",
   "actionTime": "11:24:16",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Rule provides for consideration of H.R. 3898, H.R. 3383, H.R. 3638, H.R. 3628, H.R. 3668 and S. 1071. The resolution provides for consideration of H.R. 3898, H.R. 3383, H.R. 3638, and H.R. 3628 under a structured rule; and H.R. 3668 and S. 1071 under a closed rule. The resolution provides for one motion to recommit on H.R. 3898, H.R. 3383, H.R. 3638, H.R. 3628, and H.R. 3668; and one motion to commit on S. 1071.",
   "type": "Floor"
  },
  {
   "actionCode": "H30000",
   "actionDate": "2025-12-11",
   "actionTime": "11:24:11",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Considered under the provisions of rule H. Res. 936. (consideration: CR H5768-5787; text of amendment in the nature of a substitute: CR H5775-5779)",
   "type": "Floor"
  },
  {
   "actionCode": "H1L210",
   "actionDate": "2025-12-09",
   "actionTime": "19:52:18",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Rules Committee Resolution H. Res. 936 Reported to House. Rule provides for consideration of H.R. 3898, H.R. 3383, H.R. 3638, H.R. 3628, H.R. 3668 and S. 1071. The resolution provides for consideration of H.R. 3898, H.R. 3383, H.R. 3638, and H.R. 3628 under a structured rule; and H.R. 3668 and S. 1071 under a closed rule. The resolution provides for one motion to recommit on H.R. 3898, H.R. 3383, H.R. 3638, H.R. 3628, and H.R. 3668; and one motion to commit on S. 1071.",
   "type": "Floor"
  },
