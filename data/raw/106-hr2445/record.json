 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-07-01",
   "text": "Mental Health Parity Enhancement Act of 1999 - Amends the Employee Retirement Income Security Act of 1974 (ERISA), Public Health Service Act, and the Internal Revenue Code to specify that mental health parity provisions apply to annual and lifetime visit or benefit limits, as well as to dollar limits set by health plans."
  }
