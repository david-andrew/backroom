 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1990-06-07",
   "text": "Savings Association Law Enforcement Improvement Act of 1990 - Directs the Attorney General to: (1) take action to increase the investigation and prosecution of savings association criminal misconduct; (2) take increased action to recover or obtain restitution for losses incurred as a result of savings association fraud or embezzlement; and (3) make quarterly reports to certain congressional committees on the status of savings association criminal investigations and prosecutions and the progress in recovering amounts lost to fraud and embezzlement."
  }
 ],
