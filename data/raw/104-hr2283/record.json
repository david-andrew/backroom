 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-09-07",
   "text": "Prohibits the Secretary of Health and Human Services from: (1) regulating the sale or use of tobacco or tobacco products under the Federal Food, Drug, and Cosmetic Act; and (2) taking any similar action under the Federal Cigarette Labeling and Advertising Act or the Comprehensive Smokeless Tobacco Health Education Act of 1986 which was not authorized before enactment of this Act."
  }
 ],
