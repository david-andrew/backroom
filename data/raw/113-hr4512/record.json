 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2014-04-29",
   "text": "Alternative Maximum Tax Act or the Max Tax Act - Amends the Internal Revenue Code to provide for an alternative maximum tax for a taxpayer other than a corporate taxpayer. Limits the tax to 50% of the taxpayer's adjusted gross income, calculated by adding all federal, state, and local taxes paid by the taxpayer during the taxable year and dividing that amount by the taxpayer's adjusted gross income."
  }
 ],
