 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-02-04",
   "text": "Energy Security Tax Act - Amends the Internal Revenue Code to impose an excise tax on the first sale within the United States of imports of: (1) crude oil; (2) refined petroleum products; and (3) petrochemical feedstocks or petrochemical derivatives."
  }
