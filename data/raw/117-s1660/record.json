 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2021-05-17",
   "text": "Health Equity and Access under the Law for Immigrant Women and Families Act of 2021 or the HEAL Immigrant Women and Families Act of 2021\n This bill extends Medicaid and Children's Health Insurance Program coverage to individuals lawfully present in the United States who otherwise meet eligibility requirements. Individuals granted federally authorized presence also are required to maintain minimum essential health insurance coverage and are eligible for health insurance exchanges, reduced cost sharing, premium subsidies, and premium tax credits."
  }
 ],
