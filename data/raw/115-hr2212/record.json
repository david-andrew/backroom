 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-04-27",
   "text": "Creating and Restoring Equal Access To Equivalent Samples Act of 2017 or the CREATES Act of 2017\n This bill permits the developer of a drug or biological product to bring a civil action against the license holder of an approved drug or biological product if the holder has declined to make available sufficient quantities of the approved drug or product for the developer's testing."
  }
