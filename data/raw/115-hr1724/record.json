 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-03-24",
   "text": "End of Debtors Prison Act of 2017\n This bill amends the Omnibus Crime Control and Safe Streets Act of 1968 to prohibit the Department of Justice from allocating Edward Byrne Memorial Justice Assistance Grant program funding to a state or local government that has a contract with a person (e.g., a private probation company) who: (1) collects unpaid debt (i.e., state- or court-imposed fines or fees) from an individual placed on probation for failing to pay such debt; and (2) charges separate fees (e.g., monthly fees) to the probationer with respect to the collection."
  }
 ],
