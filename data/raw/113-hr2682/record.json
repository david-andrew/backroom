 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-07-11",
   "text": "Defund Obamacare Act of 2013 - Prohibits any federal funds from being made available to carry out the provisions of the Patient Protection and Affordable Care Act or the health care provisions of the Health Care and Education Reconciliation Act of 2010.\n Prohibits any entitlement to benefits under such provisions from remaining in effect on and after the date of the enactment of this Act. Prohibits any payments from being awarded, owed, or made to any state, district, or territory under any such provision.\n Rescinds any unobligated balances available under such provisions."
  }
 ],
