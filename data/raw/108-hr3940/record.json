 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2004-03-11",
   "text": "Amends the Solid Waste Disposal Act to require: (1) secondary containment of any new or replaced underground storage tank system; and (2) the monitoring for leaks of the space between the primary and secondary containment if the new or replaced tank or piping are within 1,000 feet of a community water system, potable drinking water well, or other sensitive area. \n Establishes civil penalties for a violation of these requirements."
  }
 ],
