 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-02-27",
   "text": "Credit Card Grace Period Act of 1991 - Amends the Truth in Lending Act, with regard to any credit card account under an open end consumer credit plan which provides that any credit extended may be repaid during a period beginning on the billing date without a finance charge, to prohibit considering any date before the postmark of the statement as the billing date."
  }
