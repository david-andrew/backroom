 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2021-07-14",
   "text": "Ending Forced Arbitration of Sexual Assault and Sexual Harassment Act of 2021\n This bill invalidates arbitration agreements that preclude a party from filing a lawsuit in court involving sexual assault or sexual harassment."
  },
  {
   "version": "Reported to Senate",
   "date": "2021-11-17",
   "text": "Ending Forced Arbitration of Sexual Assault and Sexual Harassment Act of 2021\n This bill invalidates arbitration agreements that preclude a party from filing a lawsuit in court involving sexual assault or sexual harassment, at the election of the party alleging such conduct."
  }
 ],
