 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-05-22",
   "text": "Help Expand Access to Recovery and Treatment (HEART) Act of 2003 - Amends the Public Health Service Act, the Employee Retirement Income Security Act of 1974, and the Internal Revenue Code to provide for parity in the application of treatment limitations and financial requirements to substance abuse treatment benefits under group health plans and individual health insurance coverage."
  }
 ],
