 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2007-02-08",
   "text": "Consumer Overdraft Protection Fair Practices Act - Amends the Truth in Lending Act to set forth restrictions on: (1) overdraft protection programs or services for consumers; and (2) representations or statements with respect to such a program or service in any advertisement or promotion.\n Amends the Electronic Fund Transfer Act and the Expedited Funds Availability Act to set forth restrictions on overdraft protection programs or services for consumers."
  }
 ],
