 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-01-03",
   "text": "Original Living Wage Act of 2017\n This bill amends the Fair Labor Standards Act of 1938 to increase the federal minimum wage to the minimum hourly wage sufficient for a person working for 40 hours per week, 52 weeks per year, to earn an annual income 15% higher than the federal poverty threshold for a four-person household, with two children under age 18, and living in the 48 contiguous states.\n The Department of Labor (DOL) shall determine the minimum wage rate by June 1, 2017, and review it every four years. DOL may not adjust the minimum wage to a lower rate."
  }
 ],
