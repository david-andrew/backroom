 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2012-03-30",
   "text": "Requiring Easy and Accurate Labeling of Beef Act or the REAL Beef Act - Amends the Federal Meat Inspection Act to require a package or other container of meat at the final point of sale that contains low-temperature rendered product (lean finely textured beef) to bear a label stating that it contains such product."
  }
