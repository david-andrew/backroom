 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-01-05",
   "text": "End Tax Uncertainty Act of 2011 - Makes permanent: (1) the Economic Growth and Tax Relief Reconciliation Act of 2001; (2) provisions of the Jobs and Growth Tax Relief Reconciliation Act of 2003 that reduce income tax rates on dividend and capital gains income; and (3) the repeal of the estate, gift, and generation-skipping transfer taxes. \n Amends the Internal Revenue Code to: (1) repeal the alternative minimum tax (AMT) on individual taxpayers; and (2) reduce to 25% the maximum income tax rate on corporations, including personal service corporations."
  }
 ],
