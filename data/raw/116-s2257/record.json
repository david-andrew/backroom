 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-07-24",
   "text": "Fair Elections Now Act of 2019\n This bill establishes the Fair Elections Fund, which shall provide funding to Senate candidates who meet specified conditions and agree to abide by certain requirements, such as limits on types of campaign funding sources. The bill also revises provisions related to broadcasts of Senate campaign advertisements and imposes a tax on certain U.S. government contracts."
  }
