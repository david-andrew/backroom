 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-12-19",
   "text": "Affordable Drug Manufacturing Act of 2019\n This bill establishes the Office of Drug Manufacturing within the Department of Health and Human Services to lower prices for, increase access to, and address shortages of prescription drugs (e.g., insulin, naloxone, and antibiotics), including by manufacturing prescription drugs and selling them at a fair price."
  }
