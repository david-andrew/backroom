 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-05-11",
   "text": "Farm Program Payment Limitations Reform Act of 1993 - Amends the Food Security Act of 1985 to revise specified farm program limitations, including repeal of the three-entity rule. Amends the National Wool Act of 1954 to reduce annual wool or mohair payment limitations. Amends the Food Security Act of 1985 to direct the General Accounting Office to review the implementation of the payment revisions made by this Act."
  }
 ],
