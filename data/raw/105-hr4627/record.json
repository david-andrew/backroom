 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1998-09-25",
   "text": "Prescription Drug Fairness for Seniors Act of 1998 - Directs the Secretary of Health and Human Services to furnish each Medicare beneficiary under title XVIII of the Social Security Act with a drug benefit card enabling the beneficiary to purchase covered outpatient prescription drugs listed on the Federal Supply Schedule from participating pharmacies at reduced prices."
  }
