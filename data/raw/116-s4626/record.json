 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2020-09-17",
   "text": "Setting an American Framework to Ensure Data Access, Transparency, and Accountability Act or the SAFE DATA Act\n This bill establishes various requirements relating to the collection of consumer data, data transparency and security, and corporate accountability, including limiting the amount of data a covered entity may collect and prohibiting manipulation of data intended to increase the usage of online services (e.g., incorporating auto-play functions without the consent of a user)."
  }
 ],
