 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-11-03",
   "text": "No Drilling in Our Backyards Act\n This bill amends the Mineral Leasing Act to prohibit the Department of the Interior from issuing a permit for any oil and gas drilling operation that is located within 1,500 feet from a home, business, school, or other building that requires special protection."
  }
