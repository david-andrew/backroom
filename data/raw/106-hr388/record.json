 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-01-19",
   "text": "Prohibits the Secretary of the Interior from issuing a lease, permit, or license for oil or gas exploration or extraction on specified portions of the Outer Continental Shelf on both the Atlantic and Pacific coasts, including Alaska. Excludes from such proscription the Central and Western Gulf of Mexico planning areas of the Department of the Interior."
  }
