 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-07-25",
   "text": "States' Right To Innovate in Health Care Act of 2003 - Amends the Social Security Act to add a new title XXII (State Comprehensive Health Care and Cost Containment Demonstration Projects) to allow up to ten States to receive from the Secretary of Health and Human Services a planning grant and a demonstration grant to achieve a cost-effective delivery system of universal, comprehensive health care with simplified administration."
  }
 ],
