 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-03-13",
   "text": "Permanently Protecting Tenants at Foreclosure Act of 2015\n This bill amends the Protecting Tenants at Foreclosure Act of 2009 to repeal its sunset date December 31, 2014 (thus making the Act permanent). \n This bill restores and revives such Act, the provisions of law amended or repealed by it, and any regulations promulgated pursuant to it, as were in effect on December 31, 2014, as if the sunset had not taken effect."
  }
 ],
