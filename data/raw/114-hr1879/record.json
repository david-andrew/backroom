 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-04-16",
   "text": "Foreclosure Fairness Act of 2015 \n Prohibits a court, in the case of any federally related mortgage loan made after enactment of this Act, from entering a deficiency judgment requiring the mortgagor to pay any balance on the mortgage loan after a foreclosure sale of the mortgaged property."
  }
