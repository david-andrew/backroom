 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-03-13",
   "text": "Prohibits (until enactment of a law that is a successor to the Food, Agriculture, Conservation, and Trade Act of 1990) the Secretary of Agriculture, the Secretary of the Army, and the Administrator of the Environmental Protection Agency from delineating wetlands to carry out subtitle C (Wetland Conservation) of title XII of the Food Security Act of 1985 and provisions of the Federal Water Pollution Control Act relating to permits for dredged or fill material."
  }
