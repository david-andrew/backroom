 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2010-03-25",
   "text": "Stop Oxy Abuse Act of 2010 - Directs the Commissioner of Food and Drugs (FDA), within 90 days, to take such actions as may be necessary to modify the approval of, and limit any subsequent approval of, any drug containing controlled-release oxycodone hychloride to use for the relief of severe-only pain instead of moderate-to-severe pain.\n Applies any such modification to drugs introduced into interstate commerce 180 days after enactment of this Act."
  }
 ],
