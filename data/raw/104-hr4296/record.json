 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1996-09-28",
   "text": "Breast Cancer Patient Protection Act of 1996 - Requires health plans that provide medical and surgical benefits for the treatment of breast cancer to ensure that inpatient coverage is provided for a minimum of 48 hours after a mastectomy, and 24 hours after a lymph node disection, except where the attending physician and patient determine that a shorter period is appropriate. Prohibits health plans from modifying the terms and conditions of coverage based on an enrollee's determination to request less than the minimum coverage required. Prescribes appropriate health plan notice requirements regarding required coverage."
  }
 ],
