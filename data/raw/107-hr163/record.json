 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-01-03",
   "text": "Mortgage Servicing Clarification Act - Amends the Fair Debt Collection Practices Act to exempt a servicer of federally related mortgage loans secured by first liens from certain debt collection disclosure requirements if such servicer is a debt collector whose primary function is servicing such loans."
  }
