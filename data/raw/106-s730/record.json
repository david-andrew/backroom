 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1999-03-25",
   "text": "Fire Safe Cigarette Act of 1999 - Directs the Consumer Product Safety Commission to promulgate a rule that establishes a fire safety standard for cigarettes, including a prohibition on stockpiling cigarettes covered by such rule. Prohibits the manufacture or import of cigarettes not in compliance with such standard. Authorizes a person adversely affected by such standard to file a petition for judicial review within a specified time period."
  }
 ],
