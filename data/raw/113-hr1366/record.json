 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-03-21",
   "text": "Stop Oxy Abuse Act of 2013 - Directs the Commissioner of Food and Drugs (FDA), within 90 days, to take such actions as may be necessary to modify the approval of, and limit any subsequent approval of, any drug containing controlled-release oxycodone hychloride to use for the relief of severe-only pain instead of moderate-to-severe pain."
  }
