 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-12-26",
   "text": "Ending Forced Arbitration of Sexual Harassment Act of 2017\n This bill prohibits a predispute arbitration agreement from being valid or enforceable if it requires arbitration of a sex discrimination dispute.\n The prohibition does not apply to an arbitration provision in a contract between an employer and a labor organization or between labor organizations, subject to limitations."
  }
 ],
