   "actionTime": "18:54:57",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "House resolved itself into the Committee of the Whole House on the state of the Union pursuant to H. Res. 422 and Rule XXIII.",
