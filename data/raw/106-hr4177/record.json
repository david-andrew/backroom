 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2000-04-04",
   "text": "Minimum Wage Act of 2000 - Amends the Fair Labor Standards Act of 1938 to increase the Federal minimum wage (currently $5.15 per hour) to: (1) $5.65 per hour during the year beginning July 1, 2000; and (2) $6.15 per hour beginning July 1, 2001."
  }
