 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-04-03",
   "text": "Amends the Internal Revenue Code, with respect to taxation of U.S. shareholders of controlled foreign corporations, to permanently extend the subpart F exemption (which excludes such income from the shareholder's foreign personal holding company income) for active financing (banking, financing, or similar business) income earned on business operations overseas. (Thus permits American financial services firms doing business abroad to defer U.S. tax on their earnings from their foreign financial services operations until such earnings are returned to the U.S. parent company.)"
  }
 ],
