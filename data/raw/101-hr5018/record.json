 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1990-06-13",
   "text": "Fair and Reasonable Payment Limitations Act of 1990 - Amends the Food Security Act of 1985 with regard to assistance limitations and the Agricultural Act of 1949 with regard to emergency livestock assistance limitations to attribute payments to natural persons in proportion to their ownership interest in a corporation, partnership, or other specified entity. Amends the Food Security Act of 1985 to set forth specified payment limitations for the 1991 through 1995 crops."
  }
 ],
