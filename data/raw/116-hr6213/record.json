 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-03-11",
   "text": "No Cost for COVID–19 Testing Act\n This bill requires private health insurance plans to cover testing for COVID-19 (i.e., coronavirus disease 2019) without imposing cost sharing for the duration of the public health emergency declared on January 31, 2020. This includes the cost of administering such approved tests and visits to health care providers for testing."
  }
 ],
