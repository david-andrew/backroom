 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-04-11",
   "text": "Crane Tithe Tax Act of 2003 - Amends the Internal Revenue Code to: (1) repeal the tax on corporations; (2) repeal the current tax rates for individuals and replace such rates with a ten percent tax on earned income; (3) provide amnesty for any tax liability prior to January 1, 2002; (4) repeal all specific exclusions from gross income, all deductions, and all credits; and (5) repeal subtitle B relating to estate, gift, and generation-skipping taxes."
  }
 ],
