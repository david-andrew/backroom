 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-03-23",
   "text": "Amends the Internal Revenue Code to reduce the maximum capital gains rate from: (1) 28 percent to 15 percent for noncorporate taxpayers; and (2) 34 percent to 15 percent for corporate taxpayers. Reduces from 20 percent to 15 percent the tax rate on capital gains under the alternative minimum tax."
  }
