 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-05-12",
   "text": "Corporate Accountability Act\n This bill requires corporations that receive federal aid related to COVID-19 (i.e., coronavirus disease 2019) to (1) provide at least 14 days of fully paid leave to all workers, (2) pay each employee a wage of not less than $15 an hour, and (3) limit CEO and executive pay."
  }
