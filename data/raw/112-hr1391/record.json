 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-04-06",
   "text": "Recycling Coal Combustion Residuals Accessibility Act of 2011 or the RCCRA Act of 2011 - Amends the Solid Waste Disposal Act to exempt fly ash waste, bottom ash waste, slag waste, and flue gas emission control waste generated primarily from the combustion of coal or other fossil fuels from regulation as hazardous waste under such Act."
  }
 ],
