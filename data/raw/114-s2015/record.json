 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2015-09-09",
   "text": "Protecting Local Business Opportunity Act\n This bill amends the National Labor Relations Act to allow two or more employers to be considered joint employers for purposes of the Act only if each shares and exercises control over essential terms and conditions of employment and such control over these matters is actual, direct, and immediate."
  }
 ],
