 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2026-01-06",
   "text": "Stop Unfair Medicaid Recoveries Act \nThis bill prohibits state Medicaid programs from using estate recovery to recoup the costs of benefits. States must withdraw property liens within 90 days of the bill's enactment and notify affected individuals of the withdrawals."
  }
