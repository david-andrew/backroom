 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-01-13",
   "text": "Providing Urgent Maternal Protections for Nursing Mothers Act or the PUMP for Nursing Mothers Act \n This bill extends protections for a working mother who expresses breast milk for her nursing child to cover salaried employees and other types of workers not covered under existing law. The bill requires employers to pay a nursing mother who is paid on an hourly basis for time spent to express breast milk if she is also working."
  }
 ],
