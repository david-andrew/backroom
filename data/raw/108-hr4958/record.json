 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2004-07-22",
   "text": "Energy Independence for a Strong America Act of 2004 - Directs the Secretary of the Interior to conduct a sale of oil and gas leases on all submerged lands of the Outer Continental Shelf in the Eastern Gulf of Mexico that: (1) are depicted on a specified Minerals Management Service document as \"Leased or Deferred--Not Offered;\" and (2) are not subject to a lease under the Outer Continental Shelf Lands Act."
  }
 ],
