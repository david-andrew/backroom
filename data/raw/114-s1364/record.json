 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2015-05-18",
   "text": "Medicaid Generic Drug Price Fairness Act of 2015\n This bill amends title XIX (Medicaid) of the Social Security Act to increase the amount of rebate with respect to each generic drug in the manner that the rebate for a dosage form and strength of a single source drug or an innovator multiple source drug is increased, except as provided in special application rules, including a special rule for certain noninnovator multiple source drugs."
  }
 ],
