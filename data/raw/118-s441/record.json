 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-02-15",
   "text": "American Opportunity Accounts Act\n This bill establishes tax-exempt American Opportunity Accounts to provide children at birth with a $1,000 savings account with annual contributions up to $2,000 depending on family income. The accounts are available to children at age 18 for specified purposes, including educational expenses, home ownership, and investment that provides long-term returns."
  }
