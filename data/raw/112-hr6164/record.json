 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2012-07-23",
   "text": "Declares that no presidential permit shall be required for the pipeline application filed on May 4, 2012, by TransCanada Corporation for the northern portion of the Keystone XL pipeline from the Canadian border to the South Dakota/Nebraska border. \n Deems the final environmental impact statement issued by the Secretary of State on August 26, 2011, to satisfy all requirements of the National Environmental Policy Act of 1969. \n Declares that this Act does not affect the ongoing work of the state of Nebraska with regard to the fully intrastate portion of the Keystone XL pipeline."
  }
 ],
