 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-02-26",
   "text": "Fairness in Nursing Home Arbitration Act of 2009 - Provides that a pre-dispute arbitration agreement between a long-term care facility and a resident (or anyone acting on the resident's behalf) shall not be valid or specifically enforceable."
  }
