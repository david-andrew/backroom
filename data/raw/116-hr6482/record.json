 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-04-10",
   "text": "Protecting Our Pharmaceutical Supply Chain from China Act of 2020\n This bill requires the federal government to maintain a registry of certain foreign-sourced drugs, prohibits federal health care programs from purchasing drugs containing Chinese ingredients, requires drugs to be labeled for country of origin, and offers domestic manufacturing facility tax incentives."
  }
