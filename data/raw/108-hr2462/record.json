 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-06-12",
   "text": "Protect Diversity in Media Act - Invalidates the final rules adopted by the Federal Communications Commission (FCC) pursuant to its broadcast media ownership proceeding and announced on June 2, 2003. Reinstates (retroactively, as in effect prior to such announcement) any rule that the FCC modified pursuant to that proceeding.\n Prohibits the FCC from using current biennial rule review authority to review broadcast media ownership rules."
  }
 ],
