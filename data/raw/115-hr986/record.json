 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-02-09",
   "text": "Tribal Labor Sovereignty Act of 2017\n This bill amends the National Labor Relations Act (NLRA) to exclude Native American tribes and tribal enterprises and institutions on tribal land from requirements for employers under the NLRA. (Currently under the NLRA, employers may not engage in unfair labor practices and must allow employees to form unions, engage in collective bargaining, and take collective action.)"
  },
  {
   "version": "Reported to House with amendment(s)",
   "date": "2017-09-25",
   "text": "Tribal Labor Sovereignty Act of 2017\n (Sec. 2) This bill amends the National Labor Relations Act (NLRA) to exclude Native American tribes and tribal enterprises and institutions on tribal land from requirements for employers under the NLRA. (Currently under the NLRA, employers may not engage in unfair labor practices and must allow employees to form unions, engage in collective bargaining, and take collective action.)"
  }
 ],
