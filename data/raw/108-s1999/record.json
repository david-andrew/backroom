 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2003-12-09",
   "text": "Medicare Prescription Drug Price Reduction Act - Amends part D (Voluntary Prescription Drug Benefit Program) of title IV of the Social Security Act, as amended by the Medicare Prescription Drug, Improvement, and Modernization Act of 2003, to give the Secretary of Health and Human Services authority to negotiate prices in contracts with manufacturers of covered Medicare part D drugs."
  }
