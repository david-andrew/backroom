 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-02-08",
   "text": "Liveable Wage Act of 1999 - Amends the Fair Labor Standards Act of 1938 to: (1) increase the minimum wage to $6.50 an hour, beginning after December 30, 1999; and (2) provide that the minimum wage rate shall be increased by indexing to the cost of living, in the same manner as benefits are indexed under the Social Security Act, for calendar year 2000 and thereafter."
  }
 ],
