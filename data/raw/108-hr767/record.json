 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-02-13",
   "text": "Homeland Investment Act of 2003 - Amends the Internal Revenue Code to permit a U.S. corporation doing business abroad to elect to have its foreign earnings taxed in the United States for one year at a rate equal to 5.25 percent of the excess qualified foreign distribution and the amount attributable to such corporation as controlled foreign-earned dividends in lieu of being taxed under individual or corporate rates.Limits foreign tax credits with respect to dividends taxed at such 5.25 percent rate."
  }
 ],
