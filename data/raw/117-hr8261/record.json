 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-07-01",
   "text": "Hotel Advertising Transparency Act of 2022\n\n This bill requires hotels, and other places of short-term lodging, to include all required fees in the advertised rate.\n This requirement may be enforced by the Federal Trade Commission, state attorneys general, and other authorized state officials."
  }
