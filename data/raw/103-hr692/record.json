 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-01-27",
   "text": "Liveable Wage Act of 1993 - Amends the Fair Labor Standards Act of 1938 to: (1) increase the minimum wage to $5.50 an hour in 1994; and (2) provide that the minimum wage rate will be increased by indexing to the cost of living, in the same manner as benefits are indexed under specified provisions of the Social Security Act, for 1995 and thereafter."
  }
