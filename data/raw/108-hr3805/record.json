 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2004-02-11",
   "text": "Los Padres National Forest Conservation Act - Withdraws the Los Padres National Forest in California from: (1) all forms of entry, appropriation, and disposal under the public land laws; and (2) location, entry, and patent under the mining laws; and (3) operation of the mineral leasing, mineral materials, and geothermal leasing laws."
  }
