 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2005-07-25",
   "text": "Minimum Wage Competitiveness Act of 2005 - Amends the Fair Labor Standards Act of 1938 to increase the federal minimum wage to: (1) $6.00 an hour, beginning on the 60th day after enactment of this Act; (2) $6.75 an hour, beginning on January 1, 2006; and (3) $7.15 an hour, beginning on January 1, 2007.\nMakes federal minimum wage requirements applicable to the Commonwealth of the Northern Mariana Islands. Sets forth a transition period during which a specified minimum wage there shall be gradually increased to equal the federal minimum wage."
  }
 ],
