 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2006-06-07",
   "text": "Firearms Transfer Improvement Act - Amends the federal criminal code to provide that in-person interstate firearms sales between a federal firearms licensee and a nonresident purchaser shall be governed only by the state law of the licensee (currently, such sales must comply with the state laws of both the licensee and the purchaser)."
  }
