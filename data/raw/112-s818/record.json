 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2011-04-14",
   "text": "Improving Access to Medicare Coverage Act of 2011 - Amends title XVIII (Medicare) of the Social Security Act to deem an individual receiving outpatient observation services in a hospital to be an inpatient with respect to satisfying the three-day inpatient hospital requirement in order to entitle the individual to Medicare coverage of any post-hospital extended care services in a skilled nursing facility (SNF)."
  }
 ],
