 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2017-10-19",
   "text": "Protect Access to Birth Control Act\n This bill nullifies interim final rules issued by the Department of Labor, the Department of the Treasury, and the Department of Health and Human Services that allow employers with religious or moral objections to be exempt from the requirement in the Patient Protection and Affordable Care Act to cover contraceptive services without cost-sharing."
  }
