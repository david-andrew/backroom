 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2021-01-28",
   "text": "Protecting Our Wealth of Energy Resources Act of 2021 or the POWER Act of 2021\n This bill requires the President and federal agencies to obtain the approval of Congress before prohibiting or substantially delaying certain new energy or mineral leases or permits on federal lands, including oil and gas leases, coal leases, hard rock leases, or critical minerals leases.\n In addition, the President and agencies must obtain the approval of Congress before withdrawing certain federal lands from mineral and geothermal leasing activities."
  }
 ],
