 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2008-09-26",
   "text": "Let Wall Street Pay for Wall Street's Illiquid Assets Act of 2008 - Amends the Internal Revenue Code to impose an excise tax on securities or commodity transactions equal to 0.25% of the value of the instruments involved in such transactions. Makes such tax payable by the trading facility on which such transactions occur."
  }
