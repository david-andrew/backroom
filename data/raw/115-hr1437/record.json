 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-03-08",
   "text": "No Money Bail Act of 2017\n This bill amends the Omnibus Crime Control and Safe Streets Act of 1968 to make ineligible for funding under the Edward Byrne Memorial Justice Assistance Grant (JAG) program a state with a bail system that uses payment of money as a condition of pretrial release in criminal cases. \n The Department of Justice must reallocate such state's JAG funding among eligible states. \n Additionally, the bill prohibits payment of money as a condition of pretrial release in any federal criminal case."
  }
 ],
