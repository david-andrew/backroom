 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1993-10-12",
   "text": "Cable Consumer Protection and Competition Act of 1993 - Repeals the Cable Television Consumer Protection and Competition Act of 1992 except for provisions relating to retransmission consent for cable systems. Applies all other sections of the Communications Act of 1934 amended by such Act as if such Act had not been enacted. Makes any regulations prescribed by the Federal Communications Commission to implement such Act ineffective after enactment of this Act."
  }
 ],
