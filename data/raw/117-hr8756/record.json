 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-08-30",
   "text": "Protect Local Farms Act\n This bill preempts state laws that provide for a maximum workweek of less than 60 hours for agricultural employees. Under federal law, agricultural employees are generally exempt from maximum hours (i.e., overtime) requirements."
  }
