 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-06-08",
   "text": "Automobile Dealer Economic Rights Restoration Act of 2009 - Prohibits any automobile manufacturer in which the federal government has an economic interest from depriving an automobile dealer of its economic rights as they existed prior to the commencement of a bankruptcy case by the manufacturer, including the dealer's rights to recourse under state law.\n Requires such manufacturers to restore the franchise agreements with dealers that were in effect prior to the bankruptcy case."
  }
 ],
