   },
   "text": "Executive Comment Received from Labor.",
   "type": "Committee"
  },
  {
   "actionCode": "H8D000",
   "actionDate": "1993-02-03",
   "actionTime": "15:11:59",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "GENERAL DEBATE - The Committee of the Whole proceeded with three hours and 20 minutes of general debate.",
   "type": "Floor"
  },
  {
   "actionCode": "H32400",
   "actionDate": "1993-02-03",
   "actionTime": "15:11:51",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The Speaker designated the Honorable Barbara B. Kennelly to act as Chairwoman of the Committee.",
   "type": "Floor"
  },
  {
   "actionCode": "H32020",
   "actionDate": "1993-02-03",
   "actionTime": "15:11:47",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "House resolved itself into the Committee of the Whole House on the state of the Union pursuant to H. Res. 58 and Rule XXIII.",
   "type": "Floor"
  },
  {
   "actionCode": "H8D000",
   "actionDate": "1993-02-03",
   "actionTime": "15:10:15",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Rule provides for consideration of H.R. 1 with 3 hours and 20 minutes of general debate. Previous question shall be considered as ordered without intervening motions except motion to recommit with or without instructions. It shall be in order to consider as an original bill for the purpose of amendment under the five-minute rule the amendment in the nature of a substitute printed in part 1 of the report of the Committee on Rules accompanying this resolution, modified by the amendment printed in section 2 of this resolution. Measure will be considered read. Specified amendments are in order.",
   "type": "Floor"
  },
  {
   "actionCode": "H30000",
   "actionDate": "1993-02-03",
   "actionTime": "15:10:10",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Considered under the provisions of rule H. Res. 58. (consideration: CR H379-447)",
   "type": "Floor"
  },
  {
   "actionCode": "H1L220",
   "actionDate": "1993-02-03",
   "actionTime": "14:27:33",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Rule H. Res. 58 passed House.",
   "type": "Floor"
  },
