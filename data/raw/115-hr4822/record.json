 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2018-01-18",
   "text": "Congressional Accountability Act of 1995 Reform Act\n This bill amends the Congressional Accountability Act of 1995 (CAA) to revise procedures for initiating, investigating, and resolving claims by legislative branch employees alleging that their employing offices have violated CAA rights and protections, including protections against sexual harassment and discrimination."
  }
