 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1994-11-29",
   "text": "Tax Rate Reduction Act of 1994 - Amends the Internal Revenue Code to repeal the highest income tax rate for individuals, lower the highest taxable income threshold, and reduce individual income tax rates from 1995 until 1998. Repeals the overall limitation on itemized deductions and the phaseout of personal exemptions."
  }
