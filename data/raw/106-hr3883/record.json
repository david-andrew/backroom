 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2000-03-09",
   "text": "Genetically Engineered Food Safety Act - Amends the Federal Food, Drug, and Cosmetic Act to include genetically engineered food and related materials in the definition of \"food additive.\" Requires that a petition to the Secretary of Health and Human Services for a regulation prescribing the conditions of safe use of a genetically engineered food additive include all data collected or developed pursuant to safety investigations, including data that does not support the claim of safety. Mandates a fee from petitioners to cover related costs and to provide for a program of basic and applied research on genetic food additive safety."
  }
 ],
