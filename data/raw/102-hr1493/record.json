 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-03-19",
   "text": "Account Fraud and Deception Prevention Act of 1991 - Amends the Electronic Fund Transfer Act to prohibit preauthorized transfers from a consumer's account which are made on the basis of: (1) any form of negotiation of any check by the consumer; and (2) a provision contained on any check negotiated by a consumer."
  }
 ],
