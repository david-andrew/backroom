 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-05-20",
   "text": "Protect Our Refuges Act of 2019\n This bill prohibits the use of neonicotinoids (a class of neuroactive insecticides that are chemically similar to nicotine) within the National Wildlife Refuge System."
  },
  {
   "version": "Reported to House",
