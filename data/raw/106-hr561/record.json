 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-02-03",
   "text": "Aircraft Noise Reduction Act of 1999 - Amends Federal aviation law to prohibit a person from operating any civil subsonic turbojet that fails to comply with stage three noise levels to or from an airport located in any of the 20 most populated U.S. metropolitan areas, as determined by the Secretary of Transportation."
  }
