 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-07-22",
   "text": "Baggage Fee Fairness Act of 2015\n This bill prohibits any air carrier from collecting a checked baggage fee from an air passenger if the fee amount exceeds the total amount of passenger facility charges ($1-$4.50) that could be imposed (without regard to whether the charges are actually imposed) on a passenger by eligible agencies for boarding a flight."
  }
