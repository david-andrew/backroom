 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2010-03-25",
   "text": "Renewable Fuels Reinvestment Act - Amends the Internal Revenue Code to extend through 2015 the income and excise tax credits for alcohol used as fuel, the cellulosic biofuel producer tax credit, and the reduced credit for ethanol blenders.\n Amends the Harmonized Tariff Schedule of the United States to extend until 2016 the additional tariff on ethyl alcohol blends (ethanol) used as fuel."
  }
 ],
