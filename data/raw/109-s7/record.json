 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2005-01-24",
   "text": "Jobs and Growth Tax Relief Act of 2005 - Makes permanent: (1) reductions in individual income tax rates enacted by the Economic Growth and Tax Relief Reconciliation Act of 2001 (EGTRRA); (2) reductions in individual capital gains and dividends tax rates enacted by the Jobs and Growth Tax Relief Reconciliation Act of 2003; and (3) the repeal of the estate and generation-skipping transfer taxes and reductions of the gift tax enacted by EGTRAA."
  }
 ],
