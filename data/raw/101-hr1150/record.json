 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-02-28",
   "text": "Utility Ratepayer Refund Act of 1989 - Repeals provisions of the Tax Reform Act of 1986 that describe conditions under which a normalization method of accounting will not be assumed (for purposes of recapture of certain investment tax credits) in connection with the treatment of excess deferred tax reserves of public utility companies."
  }
