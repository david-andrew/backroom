 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1999-01-19",
   "text": "Safe and Fair Enforcement and Recall for Meat and Poultry Act (SAFER Meat and Poultry Act) - Amends the Federal Meat Inspection Act and the Poultry Products Inspection Act to: (1) require a person, other than a household consumer, who has reason to believe meat or poultry products to be adulterated or misbranded to so notify the Secretary of Agriculture; and (2) provide the Secretary with authority for voluntary and mandatory nondistribution and recall, withdrawal of inspectors from violating facilities, and civil penalties."
  }
 ],
