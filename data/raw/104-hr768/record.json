 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-02-01",
   "text": "Liveable Wage Act of 1995 - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage per hour to: (1) $4.60 in 1996; (2) $4.85 in 1997; (3) $5.00 in 1998; (4) $5.15 in 1999; and (5) $5.30 in 2000 and thereafter."
  }
