 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-04-21",
   "text": "Health Care Safety Net Enhancement Act of 2009 - Amends the Public Health Service Act to deem a hospital or an emergency department and a physician or physician group of such hospital or emergency department to be an employee of the Public Health Service for purposes of any civil action that may arise due to providing emergency and post-stabilization services on or after January 1, 2010."
  }
