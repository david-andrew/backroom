 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-10-18",
   "text": "Amends the National Labor Relations Act to provide that an employer is not required to allow access to its business property to employees or nonemployees for purposes of union organizing, solicitation, distribution, picketing, or other union advocacy or activities, even if the employer allows such access to organizations for charitable, civic, or religious purposes."
  }
