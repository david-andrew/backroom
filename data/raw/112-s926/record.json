 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2011-05-09",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act or COAST Anti-Drilling Act - Amends the Outer Continental Shelf Lands Act (OCSLA) to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil, natural gas, or any other mineral in either the Mid-Atlantic or the North Atlantic planning areas."
  }
 ],
