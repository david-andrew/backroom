 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-04-30",
   "text": "SFC Richard Stayskal Military Medical Accountability Act of 2019\n This bill allows claims to be brought against the United States for damages relating to the personal injury or death of a member of the Armed Forces arising out of a negligent or wrongful act or omission in providing medical, dental, or related health care functions at a military medical treatment facility. However, the bill does not apply to care provided at a medical treatment location deployed in an area of armed combat."
  }
 ],
