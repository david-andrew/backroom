 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-03-24",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act or the COAST Anti-Drilling Act - Amends the Outer Continental Shelf Lands Act (OCSLA) to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil, natural gas, or any other mineral in either the Mid-Atlantic or the North Atlantic planning areas."
  }
 ],
