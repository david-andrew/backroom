   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "The previous question was ordered without objection.",
   "type": "Floor"
  },
  {
   "actionCode": "H36200",
   "actionDate": "1990-04-18",
   "actionTime": "17:54:48",
   "committees": [
    {
     "name": "Judiciary Committee",
     "systemCode": "hsju00",
