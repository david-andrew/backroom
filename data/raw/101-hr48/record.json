 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-01-03",
   "text": "California Ocean Sanctuary and Fisheries Enhancement Act of 1989 - Designates a specified area of the Outer Continental Shelf extending 200 miles seaward from the seaward boundary of California as the California Ocean Sanctuary, prohibiting oil and gas leasing and exploration and ocean dumping and incineration, as specified."
  }
