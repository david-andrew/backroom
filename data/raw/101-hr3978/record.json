 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1990-02-07",
   "text": "B-2 Production Termination Act - Prohibits funds appropriated to the Department of Defense (DOD) after FY 1990 from being used to commence production of B-2 aircraft. Limits the use of funds already appropriated to DOD for the B-2 to: (1) the completion of the production of such aircraft which began with funds appropriated for a fiscal year before FY 1991; and (2) research, development, test, and evaluation, including flight testing. Directs the Secretary of Defense to preserve production facilities and tooling for production of such aircraft in order to maintain an option to produce such aircraft in the future."
  }
 ],
