 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-01-03",
   "text": "Congressional Responsibility Act of 2001 - Prohibits a regulation from taking effect before the enactment of a bill comprised solely of the text of the regulation.Requires an agency, whenever it promulgates a regulation, to submit to each House of Congress a report containing its text and an explanation.Sets forth expedited congressional procedures for consideration of bills to enact agency regulations."
  }
