 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-07-17",
   "text": "Protect Against Paraquat Act\n This bill requires the Environmental Protection Agency to cancel the registration for all uses of the pesticide paraquat and to ban paraquat residue on food.\n The bill prohibits the sale and use of existing stock of paraquat."
  }
