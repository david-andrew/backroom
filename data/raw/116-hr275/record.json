 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-01-08",
   "text": "Medicare Prescription Drug Price Negotiation Act of 2019\n This bill requires the Centers for Medicare & Medicaid Services (CMS) to negotiate with pharmaceutical companies regarding prices for drugs covered under the Medicare prescription drug benefit. Current law prohibits the CMS from doing so."
  }
