 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-02-14",
   "text": "Fairness in Lending Act of 2011 - Amends the Truth in Lending Act to prohibit credit from being extended in any consumer credit transaction in which a security interest will be retained or acquired in property located within the United States which will be used as the consumer's principal residence if such consumer lacks a Social Security account number."
  }
