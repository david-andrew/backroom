  },
  {
   "actionDate": "1997-11-09",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Amendment SP 1621 agreed to in Senate by Unanimous Consent.",
   "type": "Floor"
  },
  {
   "actionDate": "1997-11-09",
   "sourceSystem": {
    "name": "Senate"
   },
   "text": "Amendment SP 1621 proposed by Senator Stevens.",
   "type": "Floor"
  },
  {
   "actionDate": "1997-11-09",
   "sourceSystem": {
