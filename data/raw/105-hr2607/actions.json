   "actionTime": "14:05:12",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "DEBATE - Pursuant to H. Res. 264, the Committee of the Whole proceeded with ten minutes of debate.",
   "type": "Floor"
  },
  {
   "actionCode": "H8D000",
