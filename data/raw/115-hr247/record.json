 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-01-04",
   "text": "Health Savings Account Expansion Act of 2017\n This bill amends the Internal Revenue Code to modify the requirements for health savings accounts (HSAs) to:\n increase the maximum contribution amounts, \n permit the use of HSAs to pay health insurance premiums and direct primary care expenses, \n repeal the restriction on using HSAs for over-the-counter medications, \n eliminate the requirement that a participant in an HSA be enrolled in a high deductible health care plan, and \n decrease the additional tax for HSA distributions not used for qualified medical expenses."
  }
 ],
