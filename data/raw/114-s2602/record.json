 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2016-02-25",
   "text": "Restoring Internet Freedom Act\n This bill nullifies the rule adopted by the Federal Communications Commission (FCC) on February 26, 2015, relating to the reclassification of broadband Internet access service as a telecommunications service. \n The FCC is prohibited from reissuing such rule in substantially the same form, or from issuing a new rule that is substantially the same, unless the rule is specifically authorized by a law enacted after enactment of this Act."
  }
 ],
