 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-06-09",
   "text": "Fracturing Responsibility and Awareness of Chemicals Act of 2009 - Amends the Safe Drinking Water Act to: (1) repeal the exemption from restrictions on underground injection of fluids near drinking water sources granted to hydraulic fracturing operations under such Act; and (2) require oil and gas companies to disclose the chemicals used in hydraulic fracturing operations."
  }
