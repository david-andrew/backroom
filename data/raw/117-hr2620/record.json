 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-04-16",
   "text": "Investor Choice Act of 2021\n This bill prohibits broker-dealers and investment advisers from including mandatory arbitration, forum selection restrictions, or bans on class action suits in a customer or client agreement. Issuers of securities are also prohibited from mandating arbitration in a shareholder agreement."
  }
