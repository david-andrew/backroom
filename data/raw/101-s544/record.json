 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1989-03-08",
   "text": "Amends the Federal bankruptcy code to include airlines (as well as, currently, railroads) under provisions which prohibit a trustee in a reorganization from altering employee wages or working conditions except in accordance with the Railway Labor Act. Allows creditors to reach the assets of a bankrupt air carrier's controlled group of corporations."
  }
