 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-06-28",
   "text": "Newborns' and Mothers' Health Protection Act of 1995 - Requires a health plan to provide maternity benefits for a minimum hospital stay for a mother and her newborn following the birth of the child. Provides an exception for home births. Requires a health plan to provide written notice, prominently positioned in any literature or correspondence, to each enrollee regarding the coverage required by this Act."
  }
 ],
