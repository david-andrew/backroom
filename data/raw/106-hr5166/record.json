 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2000-09-13",
   "text": "Quality Care for Nursing Home Patients Act of 2000 - Amends titles XVIII (Medicare) and XIX (Medicaid) of the Social Security Act to: (1) impose minimum direct care staffing requirements on nursing and skilled nursing facilities receiving Medicare or Medicaid funding; (2) provide for disclosure of staffing levels at such facilities; and (3) provide for administrative staffing requirements for such facilities."
  }
 ],
