 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-07-23",
   "text": "American Opportunity Accounts Act \n This bill requires federally funded and managed savings accounts (American Opportunity Accounts) to be established for American children who are under the age of 18. The bill also increases and modifies (1) estate and gift taxes, and (2) capital gains taxes."
  }
