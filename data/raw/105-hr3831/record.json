 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1998-05-12",
   "text": "Children's Sleepwear Safety Act of 1998 - Requires the Consumer Product Safety Commission to issue a rule amending its Flammable Fabrics Act standards to revoke specified amendments to standards for the flammability of children's sleepwear. Declares that no statute or Executive order shall apply regarding the promulgation of the amendment prescribed by this Act."
  }
