    }
   ],
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Mr. Pomeroy moved to recommit with instructions to Ways and Means. (consideration: CR H4464-4466; text: CR H4464-4465)",
   "type": "Floor"
  },
