 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2007-10-23",
   "text": "Medicare Prescription Drug Savings and Choice Act of 2007 - Amends part D (Voluntary Prescription Drug Benefit Program) of title XVIII (Medicare) of the Social Security Act to provide for: (1) establishment of one or more Medicare operated prescription drug plan options; (2) an appeals process for denials of benefits under a Medicare operated prescription drug plan; and (3) pharmacy payments under such a plan."
  }
 ],
