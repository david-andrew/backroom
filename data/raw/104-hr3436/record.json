 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1996-05-10",
   "text": "Minimum Obstetrical Medical Security Act of 1996 - MOMS Act of 1996 - Requires a health plan or an employee health benefit plan that provides maternity (including childbirth) benefits to provide coverage for a minimum period after delivery and, in certain circumstances, for post-delivery follow-up care. Prohibits a plan from taking certain punitive or incentive actions regarding mothers and providers."
  }
 ],
