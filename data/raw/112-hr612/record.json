 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-02-10",
   "text": "West Coast Ocean Protection Act of 2011 - Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil or natural gas in any area of the outer Continental Shelf off the coast of California, Oregon, or Washington."
  }
