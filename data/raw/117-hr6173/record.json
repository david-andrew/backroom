 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-12-08",
   "text": "Protecting International Pipelines for Energy Security Act\n This bill requires the President to obtain the approval of Congress before revoking a permit or other authorization required under executive orders for constructing, connecting, operating, or maintaining an oil or natural gas pipeline, an electric transmission facility, or a border-crossing facility."
  }
