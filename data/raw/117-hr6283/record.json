 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-12-14",
   "text": "Get Foreign Money Out of U.S. Elections Act\n This bill imposes prohibitions and requirements related to campaign contributions and expenditures from foreign sources. \n For example, the bill bans campaign contributions and expenditures by domestic business entities that are controlled, influenced, or owned by foreign nationals."
  }
