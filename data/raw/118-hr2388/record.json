 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2023-03-29",
   "text": "Justice for Exploited Children Act of 2023\n This bill replaces the current maximum civil penalty of $11,000 for a violation of the child labor laws with a minimum civil penalty of $5,000 and a maximum of $132,270 (or, in the case of a violation that causes death or serious injury, $25,000 and $601,150, respectively)."
  }
 ],
