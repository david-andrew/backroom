 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-05-07",
   "text": "Preventing Foreign Attempts to Erode Healthcare Innovation Act\n This bill prohibits the use of federal funds to support, allow, or facilitate the negotiation or approval of any measure at the World Trade Organization to waive intellectual property rights, including the petition titled Waiver from Certain Provisions of the TRIPS Agreement for the Prevention, Containment, and Treatment of COVID-19. (The petition was submitted by India and South Africa to suspend all intellectual property rights associated with COVID-19 innovations, such as vaccines.)"
  }
 ],
