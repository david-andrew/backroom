 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1998-02-25",
   "text": "Cable Consumer Protection Act of 1998 - Amends the Communications Act of 1934 to extend permanently (currently terminates on March 31, 1999) the authority of the Federal Communications Commission to: (1) determine the reasonableness of cable television programming rates; and (2) in appropriate cases, reduce such rates."
  }
