 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-01-08",
   "text": "Florida Coastal Protection Act\n This bill prohibits the Bureau of Ocean Energy Management from offering any tract for oil and gas leasing or preleasing in the following areas: \n the Eastern Gulf of Mexico Planning Area that is within 125 miles of the coastline of Florida,\n the South Atlantic Planning Area that is south of 30 degrees 43 minutes North Latitude, or \n the Straits of Florida Planning Area."
  }
 ],
