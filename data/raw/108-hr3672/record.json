 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2003-12-08",
   "text": "Amends part D (Voluntary Prescription Drug Benefit Program) of title XVIII (Medicare) of the Social Security Act, as added by the Medicare Prescription Drug, Improvement, and Modernization Act of 2003, to give the Secretary of Health and Human Services the authority similar to that of other Federal entities that purchase prescription drugs in bulk to negotiate contracts with manufacturers of covered part D drugs, consistent with the requirements and in furtherance of the goals of providing quality care and containing costs."
  }
 ],
