 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1990-09-12",
   "text": "National Emergency Anti-Profiteering Act of 1990 - Prohibits profiteering with respect to essential commodities following a presidential declaration of a national economic emergency. Establishes criminal penalties and civil remedies for such profiteering (including disgorgement of all profits earned). Sets forth guidelines for the duration of a national economic emergency. Authorizes the Congress to terminate by passage of a joint resolution the designation of a national economic emergency or of the essential commodities with respect to which it exists. Provides for judicial review of the President's determination regarding either an emergency or essential commodities."
  }
 ],
