 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-05-21",
   "text": "Dairy Stabilization Act of 1991 - Amends the Agricultural Act of 1949 to increase milk price support levels. Establishes a two-tier milk price support program if estimated Commodity Credit Corporation purchases exceed a specified amount. Sets forth minimum milk solid contents for whole, lowfat, and skim milk."
  }
