 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-12-06",
   "text": "Investor Choice Act of 2019\n This bill prohibits broker-dealers and investment advisers from including mandatory arbitration, forum selection restrictions, or bans on class action suits in a customer or client agreement. Issuers of securities are also prohibited from mandating arbitration in a shareholder agreement."
  }
