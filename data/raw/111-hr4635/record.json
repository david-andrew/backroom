 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2010-02-22",
   "text": "Foreclosure Mandatory Mediation Act of 2010 - Amends the Helping Families Save Their Homes Act of 2009 to require the mortgagee of certain one- to four-family residences, as a prerequisite to a foreclosure proceeding or a sheriff sale, and at the mortgagee's expense, to conduct a one-time mediation with the affected mortgagor and a housing counseling agency."
  }
 ],
