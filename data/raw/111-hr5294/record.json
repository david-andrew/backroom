 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2010-05-13",
   "text": "Limit Executive Actions Suspending Energy Act of 2010 or the LEASE Act of 2010 - Prohibits the head of any federal agency from taking any administrative action to regulate greenhouse gas emissions (including by issuing orders, promulgating regulations, or otherwise regulating, monitoring, mitigating, predicting, or documenting such emissions) for purposes of addressing climate change unless a federal statute expressly and specifically authorizes such action."
  }
