 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-01-04",
   "text": "Medicare Prescription Drug Price Negotiation Act of 2017\n This bill amends title XVIII (Medicare) of the Social Security Act to require the Centers for Medicare & Medicaid Services (CMS) to negotiate with pharmaceutical companies regarding prices for drugs covered under the Medicare prescription drug benefit. Current law prohibits CMS from doing so."
  }
 ],
