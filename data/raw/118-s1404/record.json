 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-05-02",
   "text": "Chaco Cultural Heritage Area Protection Act of 2023\n This bill withdraws certain federal land in New Mexico and authorizes the Department of the Interior to convey the land to, or exchange the land with, an Indian tribe under a resource management plan. Nonproducing oil and gas leases on the withdrawn land are terminated."
  }
