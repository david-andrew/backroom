 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1990-01-23",
   "text": "Low-Income Housing Preservation Act of 1990 - Amends the Housing and Community Development Act of 1987 to make the low-income housing mortgage prepayment limitation (and other specified housing provisions) permanent. Authorizes grants for low-income housing preservation. Amends the Internal Revenue Code to exclude from gross income the gain from the sale or exchange of qualified low-income housing."
  }
 ],
