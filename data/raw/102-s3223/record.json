 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1992-09-10",
   "text": "State Health Care Financing Equity Act of 1992 - Amends the Employee Retirement Income Security Act of 1974 (ERISA) to waive ERISA preemption requirements so as to allow States to: (1) provide for State universal health plans, State risk pools for the medically uninsurable, or prospective payment systems; and (2) impose State provider taxes."
  }
