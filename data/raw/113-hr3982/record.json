 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2014-02-03",
   "text": "Open Internet Preservation Act of 2014 - Restores rules adopted by the Federal Communications Commission (FCC) in the Report and Order in the matter of preserving the open Internet and broadband industry practices (adopted on December 21, 2010) that were vacated by the U.S. Court of Appeals for the D.C. Circuit in Verizon v. Federal Communications Commission (decided on January 14, 2014).\n Requires such rules to remain in effect until the FCC takes final action in the proceedings remanded to the FCC in such D.C. Circuit decision."
  }
 ],
