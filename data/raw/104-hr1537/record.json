 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-05-02",
   "text": "Date of Payment Act - Amends the Truth in Lending Act to require a creditor, for purposes of determining when a payment was made by a consumer on any open or closed end consumer credit plan, to treat the postmark on the envelope as the date on which payment was made, unless the consumer provides evidence that such payment was made before such date."
  }
