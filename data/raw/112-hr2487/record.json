 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-07-11",
   "text": "Reducing the Deficit through Eliminating Agriculture Direct Payment Subsidies Act of 2011 or REAPS Act of 2011 - Amends the the Food, Conservation, and Energy Act of 2008 to terminate direct payments for covered commodities and peanuts.\n Amends the Food Security Act of 1985 to limit to $65,000 per crop year: (1) average crop revenue election (ACRE) and counter-cyclical payments for one or more covered commodities, and (2) ACRE payments for peanuts.\n Applies such provisions to the 2012 crop year."
  }
 ],
