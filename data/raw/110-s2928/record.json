 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2008-04-29",
   "text": "BPA-Free Kids Act of 2008 - Treats as a banned hazardous substance under the Federal Hazardous Substances Act any consumer product that contains a detectable amount of bisphenol A (commonly known as BPA) and that is designed for or intended for use by, or care of, a child seven years of age or younger. Permits state laws that provide equal or greater protection.\n Requires a study on the health effects of BPA exposure in all age groups and in pregnant women."
  }
 ],
