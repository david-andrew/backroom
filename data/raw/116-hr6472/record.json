 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-04-07",
   "text": "COVID–19 Price Gouging Prevention Act\n This bill makes it unlawful for any person to sell or offer for sale a consumer good or service during a public health emergency resulting from COVID-19 (i.e., coronavirus disease 2019) at a price that (1) is unconscionably excessive, and (2) indicates that the seller is using the circumstances related to the public health emergency to increase prices unreasonably."
  }
 ],
