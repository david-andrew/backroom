  {
   "version": "Introduced in House",
   "date": "1989-06-13",
   "text": "Amends the Railway Labor Act to make it unlawful for any carrier, upon the conclusion of a strike, to fail to reinstate any employee with greater seniority rights than any employee who returned to employment during the strike and whom the employer seeks to retain."
  }
