 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-09-13",
   "text": "Protecting Consumers from Unreasonable Credit Rates Act of 2017\n This bill amends the Truth in Lending Act to prohibit a creditor from extending credit to a consumer under an open end consumer credit plan (credit card) for which the fee and interest rate exceeds 36%.\n The bill also sets forth criminal penalties for violations and empowers state Attorneys General to enforce the bill.\n Credit card billing statements must include the fee and interest rate, displayed as \"FAIR,\" instead of the total finance charge expressed as an annual percentage rate (APR)."
  }
 ],
