 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-12-12",
   "text": "Keep the EPA Honest Act of 2013 - Prohibits the Administrator of the Environmental Protection Agency (EPA) from proposing any standard of performance under the Clean Air Act for carbon dioxide emissions from existing fossil fuel-fired electric utility generating units before finalizing and publishing a standard of performance for such emissions from new fossil fuel-fired electric utility generating units."
  }
