 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-10-17",
   "text": "Davis-Bacon Repeal Act\n This bill repeals the Davis-Bacon Act (which requires that the locally prevailing wage rate be paid to various classes of laborers and mechanics working under federally-financed or federally-assisted contracts for construction, alteration, and repair of public buildings or public works).\n References in any law to a requirement under the Davis-Bacon Act shall be null and void."
  }
 ],
