 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-06-11",
   "text": "Millionaires Surtax Act\n This bill imposes an additional 10% tax on individual taxpayers whose modified adjusted gross income exceeds $2 million ($1 million for taxpayers not filing a joint return or surviving spouses). The bill sets forth special rules for the taxation of nonresident aliens and citizens and residents living abroad, and exempts charitable trusts from such tax."
  }
