 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-07-28",
   "text": "Fair Care Act of 2022\n\n This bill addresses the health care system, including Medicare, Medicaid, the private health insurance market, and the prescription drug approval process. The bill also revises tax provisions related to certain health care costs and establishes requirements for lawsuits involving health care provided, at least in part, through a federal program or with federal funds."
  }
 ],
