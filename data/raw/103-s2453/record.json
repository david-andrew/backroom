 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1994-09-22",
   "text": "Pathogen Reduction Act of 1994 - Title I: Amends the Federal Meat Inspection Act and the Poultry Products Inspection Act to direct the Secretary of Agriculture to establish procedures to reduce foodborne pathogen related illnesses, including: (1) tracing and recall authority; (2) civil penalties; (3) pathogen standards; and (4) import requirements. Title II: Amends specified Federal laws with regard to related control of livestock or poultry disease, including quarantine, imports, and exports."
  }
 ],
