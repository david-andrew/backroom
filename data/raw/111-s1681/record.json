 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2009-09-17",
   "text": "Health Insurance Industry Antitrust Enforcement Act of 2009 - Declares that nothing in the McCarran-Ferguson Act shall be construed to permit health insurance issuers or issuers of medical malpractice insurance to engage in any form of price fixing, bid rigging, or market allocations in connection with providing health insurance coverage or coverage for medical malpractice claims or actions.\n Makes this Act inapplicable to any information gathering and rate setting activities of any state commission of insurance or any other state regulatory entity with authority to set insurance rates."
  }
 ],
