 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-12-01",
   "text": "Drug Price Transparency in Medicaid Act of 2021\n This bill requires pass-through pricing models, and prohibits spread-pricing, for payment arrangements with pharmacy benefit managers under Medicaid. The bill also extends funding for retail pharmacy surveys and requires additional information with respect to price concessions, dispensing fees, and survey participation to be made publicly available."
  }
