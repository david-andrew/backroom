 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-10-05",
   "text": "Prioritizing Our Workers Act\n This bill amends the federal bankruptcy code to include as allowable administrative expenses in bankruptcy the unfunded vested benefits in a defined pension plan and certain pension obligations under the Employee Retirement Income Security Act of 1974 (ERISA). Claims for administrative expenses are entitled to priority in bankruptcy proceedings."
  }
 ],
