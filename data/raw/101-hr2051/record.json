 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-04-18",
   "text": "Food Labeling and Heart Disease Reduction Act of 1989 - Amends the Federal Food, Drug, and Cosmetic Act to deem foods containing fat, cholesterol, or sodium to be misbranded unless their labeling states certain information with regard to: (1) calories from fat; (2) total fat and saturated, polyunsaturated, or monounsaturated fat; (3) sodium; and (4) cholesterol."
  }
 ],
