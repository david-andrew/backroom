 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-06-17",
   "text": "Protecting Taxpayers and Communities from Local Detention Quotas Act\n This bill prohibits U.S. Immigration and Customs Enforcement from negotiating a contract with a private detention company that contains any provision relating to a guaranteed minimum number of immigration detention beds at any specific facility. \n This prohibition also applies to a contract extension or contract renegotiation."
  }
