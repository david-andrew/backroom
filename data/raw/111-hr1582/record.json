 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-03-18",
   "text": "Executive Bonus Repeal Act - Amends the Emergency Economic Stabilization Act of 2008 to repeal the exception to the general prohibition against payments of bonuses by companies receiving assistance under the Troubled Asset Relief Program (TARP) for bonus payments that were required by a written employment contract executed on or before February 11, 2009."
  }
