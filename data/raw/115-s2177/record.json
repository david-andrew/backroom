 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2017-11-30",
   "text": "Restoring Overtime Pay Act of 2017\n This bill requires the Department of Labor to update the salary threshold applicable to bona fide executive, administrative, and professional employees for purposes of determining eligibility for overtime pay. The bill adopts rulemaking promulgated by Labor in 2016 that established the threshold for exempting such employees from overtime requirements at the 40th percentile of earnings for full-time salaried employees in the lowest-wage census region. The bill also requires updates to the threshold amount every three years."
  }
 ],
