 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-05-25",
   "text": "Adjusting Davis-Bacon for Inflation Act\n This bill increases from $2,000 to $1 million the contract threshold requiring the locally prevailing wage rate to be paid to various classes of laborers and mechanics working under federally-financed or federally-assisted contracts for construction, alteration, and repair of public buildings or public works (Davis-Bacon Act)."
  }
 ],
