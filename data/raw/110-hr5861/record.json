 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2008-04-22",
   "text": "Florida Coastal Protection Act - Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from offering for oil and gas leasing or preleasing (including any related activity) any tract located in: (1) specified areas of the Eastern Gulf of Mexico; (2) a specified portion of the South Atlantic Planning Area; or (3) the Straits of Florida Planning Area."
  }
 ],
