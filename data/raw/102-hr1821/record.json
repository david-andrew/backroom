 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-04-16",
   "text": "Police Misconduct Civil Relief Act of 1991 - Authorizes the Attorney General to seek civil equitable relief against a State, political subdivision, or person acting on behalf thereof that deprives persons of their constitutional rights, privileges, or immunities through misconduct by law enforcement officers where there is a pattern or practice of such deprivations."
  }
