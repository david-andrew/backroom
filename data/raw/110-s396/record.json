 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2007-01-25",
   "text": "Amends the Internal Revenue Code to treat certain controlled foreign corporations created or organized under the laws of a tax-haven country as domestic corporations for tax purposes. Sets forth a list of \"tax-haven countries\" and grants the Secretary of the Treasury authority to remove or add a country from such list."
  }
