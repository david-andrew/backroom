 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-02-11",
   "text": "Save Our States Act - Delays the effective date of the Patient Protection and Affordable Care Act and the health care provisions of the Health Care and Education Reconciliation Act of 2010, and prohibits the federal government from promulgating any further regulations or otherwise preparing to implement the the provisions of such Acts, until the U.S. Supreme Court renders a judgment that includes a holding on the constitutionality of the requirement to maintain minimum essential coverage in any case pending before a federal court on the date of the enactment of this Act."
  }
 ],
