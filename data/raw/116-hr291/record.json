 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-01-08",
   "text": "Coastal Economies Protection Act\n This bill prohibits the Bureau of Ocean Energy Management from offering any tract for oil and gas leasing or preleasing until June 30, 2029, in the following areas:\n the North Atlantic planning area,\n the Mid-Atlantic planning area,\n the South Atlantic planning area,\n the Straits of Florida planning area, or\n the Eastern Gulf of Mexico planning area that is within 125 miles of the coastline of Florida."
  }
 ],
