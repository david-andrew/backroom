 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2023-02-02",
   "text": "This bill requires employers to provide construction employees with at least one, 15-minute paid rest break for every four hours of work.\n At the time of hiring, employers also must notify employees about their right to paid rest breaks and display information about such breaks at applicable work sites.\n Further, employers may not take retaliatory personnel actions or otherwise discriminate against employees who (1) request or take paid rest breaks, or (2) file related complaints with the Department of Labor."
  }
