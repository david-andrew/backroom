 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2018-01-11",
   "text": "New England Coastal Protection Act\n This bill amends the Outer Continental Shelf Lands Act to prohibit the Department of the Interior from issuing a lease for the exploration, development, or production of oil or natural gas off the coast of: (1) Maine, (2) New Hampshire, (3) Massachusetts, (4) Rhode Island, or (5) Connecticut."
  }
