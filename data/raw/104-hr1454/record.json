 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-04-06",
   "text": "Contact Lens Prescription Release Act of 1995 - Directs the Federal Trade Commission to amend its trade regulation rule on ophthalmic practice under 16 C.F.R. 456 to require the prescriber of contact lenses, regardless of whether or not the patient requests the prescription, to offer to release a copy of it: (1) after the fitting process is completed; or (2) in the case of a prescription renewal, immediately if there is no change in its specifications."
  }
 ],
