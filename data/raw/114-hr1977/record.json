 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-04-22",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act or the COAST Anti-Drilling Act\n Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease or other authorization for the exploration, development, or production of oil, natural gas, or any other mineral in either the Mid-Atlantic, South Atlantic, or the North Atlantic planning areas."
  }
