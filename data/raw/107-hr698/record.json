 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-02-14",
   "text": "Prescription Reimportation, Improvement, Correction, and Enhancement Act - Amends Federal Food, Drug, and Cosmetic Act provisions concerning the importation by pharmacists and wholesalers of certain prescription drugs with respect to: (1) testing and labeling; (2) nondiscrimination; and (3) a study and report. Authorizes appropriations."
  }
