 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2002-09-17",
   "text": "Fair Contracts for Growers Act of 2002 - Allows the use of arbitration to resolve a controversy as provided for under a livestock or poultry contract only if, after the controversy arises, both parties consent. Directs an arbitrator to provide to the parties to a written explanation of the factual and legal basis for an award."
  }
