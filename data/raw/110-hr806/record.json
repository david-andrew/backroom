 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2007-02-05",
   "text": "Amends the Federal Food, Drug, and Cosmetic Act to prohibit a holder of a new, approved drug application from commencing to manufacture, market, sell, or distribute a generic version of such drug from the time of the receipt of notice from the generic manufacturer that an abbreviated new drug application has been submitted for approval until the expiration or forfeiture of the exclusivity period granted to the generic manufacturer."
  }
