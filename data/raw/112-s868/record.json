 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2011-05-03",
   "text": "State Flexibility Act - Amends the Patient Protection and Affordable Care Act (PPACA) and the American Recovery and Reinvestment Act of 2009 (ARRA) to repeal certain state Medicaid and State Children's Health Insurance Program (CHIP) maintenance of effort requirements under titles XIX and XXI of the Social Security Act.\n (Under \"maintenance of efforts\" a state is prohibited from having eligibility standards, methodologies, or procedures under its state Medicaid or CHIP plan that are more restrictive than those in effect on on July 1, 2008, under ARRA or on March 23, 2010, under PPACA.)"
  }
 ],
