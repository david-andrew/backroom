 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-02-11",
   "text": "Jumpstarting Our Business Sector Act of 2011 - Amends the Internal Revenue Code to: (1) eliminate the corporate income tax and the tax on the capital gains of individuals and corporations; and (2) extend for one year the additional depreciation allowance for business and investment assets (bonus depreciation), the 100% expensing allowance for such assets, and the election to accelerate the alternative minimum tax (AMT) credit in lieu of bonus depreciation."
  }
 ],
