 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-08-06",
   "text": "Real Corporate Profits Tax Act of 2021\n This bill imposes an additional 7% tax on the adjusted net book income of a corporation that exceeds $100 million. It also allows a credit for a taxpayer, other than an S corporation, for a specified percentage of the taxpayer's net regular tax liability."
  }
