 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2021-01-28",
   "text": "This bill makes permanent several tax provisions for individual taxpayers that were enacted by the Tax Cuts and Jobs Act of 2017 and are scheduled to expire at the end of 2025. These provisions include reduction of individual income tax rates, increase in the child tax credit, limitations on the tax deduction for state and local taxes and the mortgage interest deduction, and increase in the exemption amount for estate and gift taxes."
  }
 ],
