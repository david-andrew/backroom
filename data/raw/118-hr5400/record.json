 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2023-09-12",
   "text": "Neighborhood Options for Patients Buying Medicines Act or the NO PBMs Act\nThis bill specifies that prescription drug plan sponsors and pharmacy benefit managers under the Medicare prescription drug benefit must permit any pharmacy that meets the plan's contractual terms for network participation to participate in that network and that such terms must be reasonable. The Centers for Medicare & Medicaid Services must set standards for reasonable terms."
  }
 ],
