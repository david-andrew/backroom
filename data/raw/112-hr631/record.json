 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-02-10",
   "text": "Working for Adequate Gains for Employment in Services Act or WAGES Act - Amends the Fair Labor Standards Act of 1938 (FLSA) to establish a base minimum wage for tipped employees of at least: (1) $3.75 an hour beginning 90 days after the enactment of this Act; (2) $5.00 an hour beginning one year after the change in paragraph one takes effect; and (3) beginning two years after the change in paragraph two takes effect, and adjusted as necessary thereafter, 70% of the wage in effect under FLSA but in no case less than $5.50 an hour."
  }
 ],
