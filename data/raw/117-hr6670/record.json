 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-02-09",
   "text": "Schedules That Work Act\n\n This bill provides employees with the right to request changes to their work schedules related to the number of hours they are required to work or be on call, the location of the work, the amount of notification about work schedule assignments, and fluctuations in work hours. \n\n Employers must negotiate in good faith with employees who make such requests and comply with certain work schedule notice and split shift pay requirements for retail, food service, cleaning, hospitality, or warehouse employees."
  }
 ],
