  {
   "version": "Introduced in House",
   "date": "1993-01-05",
   "text": "Civil Rights Act of 1993 - Makes it unlawful to discriminate on account of a person's sexual orientation in employment, education, credit, housing, the sale or use of goods or services, with respect to any public facility, or in any federally assisted program or activity."
  }
