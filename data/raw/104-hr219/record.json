 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-01-04",
   "text": "Sets forth a moratorium period for the Planning Areas of Southern, Central, and Northern California, during which the Secretary of the Interior may neither conduct oil or gas preleasing or leasing activities under the Outer Continental Shelf Lands Act, nor approve oil or gas exploration or development activities. Requires certain studies to be submitted to the Congress during the moratorium period."
  }
