 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-06-07",
   "text": "Davis-Bacon Modernization Act - Amends the Davis-Bacon Act to increase, from $2,000 to $100,000, the minimum contract amount required to trigger coverage under such Act (which requires that the locally prevailing wage rate be paid to various classes of laborers and mechanics working under federally-financed or federally-assisted contracts for construction, alteration, and repair of public buildings or public works)."
  }
