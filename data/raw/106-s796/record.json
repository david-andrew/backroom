 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1999-04-14",
   "text": "Mental Health Equitable Treatment Act of 1999 - Amends the Employee Retirement Income Security Act of 1974 and the Public Health Service Act to prohibit certain employee group health plans or related insurance coverages providing both medical-surgical and health benefits from imposing, in the absence of comparable medical-surgical limits: (1) mental health inpatient and outpatient benefit limits; and (2) limits on benefits for severe biologically based mental illnesses."
  }
 ],
