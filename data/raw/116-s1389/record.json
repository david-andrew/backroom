 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-05-09",
   "text": "Loan Shark Prevention Act \n This bill limits the annual percentage rate for an extension of consumer credit to 15%. The Federal Reserve Board may raise this rate if (1) money market interest rates rise over six months, and (2) it is necessary to ensure the safety and soundness of lenders."
  }
