 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1989-11-17",
   "text": "Freedom of Choice Act of 1989 - Provides that a State may not restrict the right of a woman to choose to terminate a pregnancy: (1) before fetal viability; or (2) at any time, if such termination is necessary to protect the life or health of the woman. Allows a State to impose requirements medically necessary to protect the life or health of such women."
  }
 ],
