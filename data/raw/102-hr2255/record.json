 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-05-08",
   "text": "Amends Federal patent law to extend the patent term for certain drugs composed of non-steroidal anti-inflammatory agents if during the regulatory review process the patentee: (1) filed a new drug application in 1982; (2) awaited approval by the Food and Drug Administration for at least 78 months, and (3) such new drug application was approved in 1988. Prescribes a formula for patent term extension, and sets forth administrative notification procedures."
  }
 ],
