 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-05-28",
   "text": "Affordable Insulin for the COVID-19 Emergency Act\n This bill eliminates cost-sharing under the Medicare prescription drug benefit and Medicare Advantage for insulin and associated medical supplies during the public health emergency relating to COVID-19 (i.e., coronavirus disease 2019). The bill also allows beneficiaries to receive their insulin and supplies via mail order during the emergency period."
  }
 ],
