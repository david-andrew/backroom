 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-06-15",
   "text": "Freedom From Nicotine Addiction Act of 1995 - Amends the Federal Food, Drug, and Cosmetic Act (FDCA) to make it unlawful to deliver into interstate commerce a tobacco product with a nicotine content over specified limits. Reduces those limits each year for six years. Provides for enforcement under existing FDCA enforcement provisions."
  }
