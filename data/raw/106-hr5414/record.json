 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2000-10-06",
   "text": "Tongass Rain Forest Protection Act - Prohibits, with exceptions for extant contracts, activities in the Tongass National Forest that disturb or destroy indigenous animal or plant species. Includes among such activities road construction, logging, and mining.Designates all inventoried roadless areas within the Forest as wilderness areas and National Wilderness Preservation System components."
  }
