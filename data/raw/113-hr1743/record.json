 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-04-25",
   "text": "Big Oil Bailout Prevention Act of 2013 - Amends the Oil Pollution Act of 1990 to remove the limit on liability (currently, the total of all removal costs plus $75 million) of a party responsible for an offshore facility except a deepwater port, from which oil is discharged into or upon navigable waters or adjoining shorelines."
  }
