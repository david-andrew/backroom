 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2003-03-05",
   "text": "Rx Flexibility for States Act - Amends title XIX (Medicaid) of the Social Security Act to declare that nothing prohibits a State: (1) from directly entering into drug rebate agreements that are similar to a specified rebate agreement with a manufacturer to ensure the affordability of outpatient prescription drugs in order to provide access to them by residents of a State who are not otherwise eligible for medical assistance under the Medicaid program; or (2) from making prior authorization a condition of not participating in such a similar rebate agreement."
  }
 ],
