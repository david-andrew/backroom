 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-07-11",
   "text": "Stop Predatory Investing Act \n This bill denies taxpayers owning 50 or more single family properties any tax deduction for interest paid or accrued in connection with any single family residential rental property. It also disallows depreciation of residential rental property owned by such taxpayers."
  }
