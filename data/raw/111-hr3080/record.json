 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-06-26",
   "text": "DMF Free Act of 2009 - Makes it unlawful for any person to manufacture for sale, offer for sale, or distribute in commerce any consumer product containing dimethylfumarate (DMF). \n Treats any consumer product containing DMF as a banned hazardous substance under the Federal Hazardous Substance Act and treats a violation of this Act as a violation of the Consumer Product Safety Act."
  }
 ],
