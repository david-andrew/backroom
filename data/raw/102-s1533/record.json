 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1991-07-23",
   "text": "Securities Investor Protection Act of 1991 - Amends the Securities Exchange Act of 1934 to provide that private rights of action may be brought either: (1) five years from the date on which violations of this Act occurred; or (2) two years from the date on which such violation was discovered or should have been discovered through reasonable diligence."
  }
