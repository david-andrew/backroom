 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2018-09-27",
   "text": "Strengthening Social Security Act of 2018\n This bill modifies the Old Age, Survivors, and Disability Insurance benefits program, including with respect to the determination of (1) a beneficiary's taxable income and primary-insurance amount, (2) widow or widower's benefits, and (3) cost-of-living increases in benefits."
  }
 ],
