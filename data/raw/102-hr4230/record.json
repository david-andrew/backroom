 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1992-02-14",
   "text": "Automotive Buyers Right to Know Act of 1992 - Amends the National Traffic and Motor Vehicle Safety Act of 1966 to prohibit motor vehicle manufacturers from selling, introducing, or delivering in interstate commerce or importing into the United States any motor vehicle that does not have prominently displayed a label indicating: (1) the location where it was produced; and (2) the value (stated as a percentage of the total value of the motor vehicle) of all parts produced in the United States."
  }
 ],
