 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1995-01-30",
   "text": "Teamwork for Employees and Management Act of 1995 - Amends the National Labor Relations Act to allow employers to establish, assist, maintain, or participate in an organization or entity in which employees participate to address matters of mutual interest (including issues of quality, productivity, and efficiency) if such organizations or entities cannot negotiate, enter into, or amend collective bargaining agreements."
  }
