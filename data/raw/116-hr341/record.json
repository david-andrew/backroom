 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-01-08",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act or the COAST Anti-Drilling Act\n This bill prohibits the Department of the Interior from issuing a lease or other authorization for the exploration, development, or production of oil, natural gas, or any other mineral in the Mid-Atlantic, South Atlantic, North Atlantic, Straits of Florida, or Eastern Gulf of Mexico planning areas."
  }
