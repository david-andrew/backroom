 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2005-07-12",
   "text": "Florida Coastline Protection Act of 2005 - Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil, natural gas, or any other mineral in: (1) the eastern Gulf of Mexico planning area; (2) the Straits of Florida planning area; or (3) the South Atlantic planning area, extending from the Straits of Florida planning area to the border between the States of Florida and Georgia."
  }
 ],
