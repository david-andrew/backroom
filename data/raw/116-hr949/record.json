 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-02-04",
   "text": "Free Speech Fairness Act \n This bill permits a tax-exempt organization to make certain statements related to a political campaign without losing its tax-exempt status. An organization may not lose its tax-exempt status under section 501(c)(3) of the Internal Revenue Code or be deemed to have participated in, or intervened in any political campaign on behalf of (or in opposition to) any candidate for public office, solely because of the content of any statement that (1) is made in the ordinary course of the organization's regular and customary activities in carrying out its exempt purpose, and (2) results in the organization incurring not more than de minimis incremental expenses."
  }
 ],
