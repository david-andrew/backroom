 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-03-29",
   "text": "Stop Arctic Ocean Drilling Act of 2017\n This bill declares that it is the policy of the United States that the Arctic Ocean should be managed for the best interests of the people of the United States, including by keeping fossil fuels in the ground to avoid the dangerous impacts of climate change. \n The Outer Continental Shelf Lands Act is amended to prohibit the Department of the Interior from issuing or renewing a lease or any other authorization for the exploration, development, or production of oil, natural gas, or any other mineral in the Arctic Ocean, including the Beaufort Sea and Chukchi Sea Planning Areas."
  }
 ],
