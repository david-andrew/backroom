 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2012-06-28",
   "text": "NObamacare Act of 2012 - Repeals the provisions of the Patient Protection and Affordable Care Act, and the health care provisions of the Health Care and Education and Reconciliation Act of 2010, that were not declared unconstitutional by the Supreme Court in its decision on June 28, 2012. Restores provisions of law amended by such repealed provisions."
  }
