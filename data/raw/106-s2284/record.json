 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2000-03-23",
   "text": "Minimum Wage Increase Act of 2000 - Amends the Fair Labor Standards Act of 1938 to increase the Federal minimum wage (currently $5.15 per hour) to: (1) $5.65 an hour during the year beginning April 1, 2000; and (2) $6.15 an hour beginning April 1, 2001.Makes Federal minimum wage requirements applicable to the Commonwealth of the Northern Mariana Islands, following a specified transition phase-in."
  }
 ],
