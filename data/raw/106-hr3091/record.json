 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-10-18",
   "text": "Amends Federal rail transportation law to prohibit a railroad carrier (including its officers and agents) from requiring a train employee who has been on duty or available for it for any portion of each of seven consecutive days to go on duty or be available for it until at least 72 consecutive hours have passed after the employee is released from duty or availability."
  }
