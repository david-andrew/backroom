   "actionCode": "H40150",
   "actionDate": "2010-12-21",
   "actionTime": "15:22:21",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Mr. Dingell moved that the House agree to the Senate amendments. (consideration: CR H8861-8890)",
   "type": "ResolvingDifferences"
  },
  {
   "actionCode": "H8D000",
   "actionDate": "2010-12-21",
