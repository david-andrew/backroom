 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-02-18",
   "text": "Communities Overregulating Networks Need Economic Competition Today Act or the CONNECT Act\n This bill prohibits a state or political subdivision thereof from providing or selling broadband internet access service. Such provision or sale may continue if there is no more than one other commercial provider of broadband internet access that provides competition in a particular area."
  }
