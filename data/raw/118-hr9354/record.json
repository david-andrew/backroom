 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2024-08-13",
   "text": "Single Parent Penalty Elimination Act of 2024\nThis bill revises the child tax credit by increasing its allowable amount from $1,000 to $2,000. It also repeals income eligibility limits for such credit and makes the credit fully refundable. \nAs an offset to this bill's revenue effect, the corporate income tax rate is increased from 21% to 28%."
  }
 ],
