 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-05-18",
   "text": "Main Street Tax Certainty Act \n This bill makes permanent the tax deduction for qualified business income. (Under current law, the deduction expires after December 31, 2025.)\n Qualified business income is defined as the net amount of qualified items of income, gain, deduction and loss with respect to any trade or business, excluding capital gains or losses, dividends, interest income, or income earned outside the U.S."
  }
 ],
