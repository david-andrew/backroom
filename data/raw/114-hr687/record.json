 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-02-03",
   "text": "Protect Interstate Commerce Act \n This bill prohibits a state or local government from imposing a standard or condition on the production or manufacture of agricultural products sold or offered for sale in interstate commerce if: (1) the production or manufacture occurs in another state, and (2) the standard or condition adds to standards or conditions applicable under federal law and the laws of the state or locality in which the production or manufacture occurs."
  }
 ],
