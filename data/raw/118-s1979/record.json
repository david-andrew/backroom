 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2023-06-14",
   "text": "Protecting Older Americans Act of 2023\nThis bill prohibits a predispute arbitration agreement or predispute joint-action waiver from being valid or enforceable if it requires arbitration of a dispute involving age discrimination."
  },
