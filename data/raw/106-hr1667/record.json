 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-05-04",
   "text": "Safe and Efficient Transportation Act - Authorizes a State to allow a vehicle combination of a truck tractor and one trailer or semitrailer with a consecutive set of tandem and tridem axles that may carry a gross load of 34,000 pounds on tandem axles and 51,000 pounds on tridem axles to use the Interstate System if the overall trailer length is at least 48 feet; except that such overall gross weight may not exceed 97,000 pounds for such a vehicle combination of six or more axles, including all enforcement tolerances."
  }
 ],
