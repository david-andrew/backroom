 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-06-20",
   "text": "Coastal States Protection Act - Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease for mineral exploration, development, or production on submerged lands of the Outer Continental Shelf that are seaward of, or adjacent to, specified lands under a State or Federal lease moratorium."
  }
 ],
