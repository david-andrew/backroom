    }
   ],
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Ms. Brownley (CA) moved to recommit with instructions to Financial Services. (consideration: CR H6925-6927; text: CR H6925)",
   "type": "Floor"
  },
