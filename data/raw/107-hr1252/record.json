 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-03-27",
   "text": "Arsenic Reduction in Drinking Water Act - Amends the Safe Drinking Water Act to require the maximum contaminant level for arsenic in drinking water to be: (1) ten parts per billion effective October 1, 2003; and (2) three parts per billion effective October 1, 2006.Requires the Administrator of the Environmental Protection Agency to make grants to public water systems serving fewer than 10,000 people to assist such systems in meeting the drinking water standards for arsenic."
  }
 ],
