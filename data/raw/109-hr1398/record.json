 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2005-03-17",
   "text": "Amends the Clean Air Act to require the Administrator of the Environmental Protection Agency (EPA) to promulgate regulations ensuring that after December 31, 2010, all gasoline or diesel motor vehicle fuel sold or dispensed in the contiguous United States contains not less than ten percent ethanol (in the case of gasoline) and not less than five percent biodiesel (in the case of diesel fuel)."
  }
