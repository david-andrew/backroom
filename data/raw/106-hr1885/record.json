 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1999-05-20",
   "text": "International Prescription Drug Parity Act - Amends the Federal Food, Drug, and Cosmetic Act to require manufacturers of certain drugs manufactured and domestically approved and then exported, or domestically approved and manufactured in a registered foreign establishment, to: (1) maintain specified shipment compliance and labeling records; and (2) make such records available to U.S. importers. Directs the Secretary of Health and Human Services to establish related criteria to facilitate the U.S. importation of such drugs."
  }
 ],
