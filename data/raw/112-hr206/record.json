 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2011-01-06",
   "text": "Makes permanent: (1) the Economic Growth and Tax Relief Reconciliation Act of 2001; and (2) the reductions in tax rates for dividend and capital gain income enacted by the Jobs and Growth Tax Relief Reconciliation Act of 2003.\n Amends the Internal Revenue Code to make permanent: (1) the tax deductions for state and local sales taxes and for tuition and related expenses; and (2) the increased expensing allowance (i.e., $125,000) for depreciable business assets, including computer software."
  }
 ],
