 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2001-08-02",
   "text": "Minimum Wage Restoration Act - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage (currently $5.15 per hour): (1) to $6.65, for 2002; (2) to $8.15, for 2003; and (3) by indexing to the cost of living, in the same manner as benefits are indexed under the Social Security Act, for 2004 and thereafter."
  }
