   "actionDate": "2008-07-30",
   "actionTime": "16:05:55",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Considered under suspension of the rules. (consideration: CR H7546-7577)",
   "type": "Floor"
  },
