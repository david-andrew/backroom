 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-05-16",
   "text": "Davis-Bacon Repeal Act - Repeals the Davis-Bacon Act (which requires that the locally prevailing wage rate be paid to various classes of laborers and mechanics working under federally-financed or federally-assisted contracts for construction, alteration, and repair of public buildings or public works).\n States that references in any law to a wage requirement of the Davis-Bacon Act after the enactment of this Act shall be null and void."
  }
 ],
