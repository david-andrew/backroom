 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2009-10-22",
   "text": "Internet Freedom Act of 2009 - Prohibits the Federal Communications Commission (FCC) from proposing, promulgating, or issuing any regulations with regard to the Internet or IP-enabled services. \n Makes such prohibition non-applicable to regulations that are determined necessary to: (1) prevent damage to U.S. national security; (2) ensure public safety; (3) assist or facilitate any actions taken by federal and state law enforcement agencies; or (4) ensure the solvency of the Universal Service Fund."
  }
 ],
