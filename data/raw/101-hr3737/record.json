 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-11-19",
   "text": "Amends the Internal Revenue Code to impose an excise tax on the use of virgin materials in the manufacture or production of taxable products. Establishes the Recycling Assistance and Solid Waste Management Planning Trust Fund to support certain programs under the Solid Waste Disposal Act. Provides for financing the trust fund with the excise tax on the use of virgin materials."
  }
 ],
