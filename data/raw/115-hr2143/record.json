 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2017-04-25",
   "text": "Donald J. Trump Wealth Tax Act of 2017 \n This bill imposes a 14.25% tax on any U.S. citizen, resident, or applicable trust with a net worth that exceeds $10 million. The tax applies to the portion of the net worth that exceeds $10 million, excluding the value of any principal residence and its indebtedness."
  }
