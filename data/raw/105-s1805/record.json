 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1998-03-19",
   "text": "Fair Minimum Wage Act of 1998 - Amends the Fair Labor Standards Act of 1938 to increase the Federal minimum wage (currently $5.15 per hour) to: (1) $5.65 an hour during the year 1999; and (2) $6.15 an hour during the year 2000."
  }
