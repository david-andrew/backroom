 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1997-07-22",
   "text": "American Family Fair Minimum Wage Act of 1997 - Amends the Fair Labor Standards Act of 1938 to increase the Federal minimum wage per hour, beginning on September 1 of the years mentioned, to: (1) $5.65 in 1998; (2) $6.15 in 1999; (3) $6.65 in 2000; (4) $6.95 in 2001; and (5) $7.25 in 2002."
  }
 ],
