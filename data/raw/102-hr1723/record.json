 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-04-11",
   "text": "Toy Safety and Child Protection Act - Directs the Consumer Product Safety Commission to issue a regulation requiring cautionary labeling warning of any dangers to children of specific ages for any children's toy which: (1) is manufactured for sale, offered for sale, distributed in commerce, or imported into the United States; and (2) includes a small part, as defined by the Commission."
  }
