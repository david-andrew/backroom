 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-05-02",
   "text": "Roadless Area Conservation Act of 2019\nThis bill bars the Department of Agriculture from allowing the construction of roads, the reconstruction of roads, or logging in an inventoried roadless area where those activities are prohibited by the Roadless Rule (i.e., certain federal regulations relating to roadless area management)."
  }
