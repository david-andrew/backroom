 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1991-01-14",
   "text": "Domestic Petroleum Security Act of 1991 - Amends the Internal Revenue Code to impose an excise tax on the first sale within the United States of any crude oil or refined petroleum product imported into the United States. (The tax is imposed on first use if no prior tax has been imposed.) Exempts crude oil and refined petroleum products purchased for export."
  }
