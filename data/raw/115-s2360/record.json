 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2018-01-30",
   "text": "Safe Freight Act\n This bill prohibits the operation of a freight train or light locomotive engine used in the movement of freight unless it has a crew of at least two individuals, one of whom is certified by the Federal Railroad Administration as a locomotive operator and the other as a train conductor."
  }
