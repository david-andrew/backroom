 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2014-03-13",
   "text": "Act to Ban Zohydro - Ends the sale and distribution of pure hydrocodone bitartrate extended-release capsules (marketed as Zohydro ER) within 45 days by withdrawing approval for its new drug application. Prohibits the Commissioner of Food and Drugs (FDA) from approving any new drug application for the capsules unless they are formulated to prevent abuse."
  }
 ],
