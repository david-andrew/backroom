 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2007-03-22",
   "text": "Re-Empowerment of Skilled and Professional Employees and Construction Tradesworkers (RESPECT) Act - Amends the National Labor Relations Act to revise the definition of \"supervisor\" in the following ways: (1) require the individual to have authority over employees for a majority of the individual's worktime; and (2) remove authority to assign other employees and to responsibly direct employees as conditions for being considered a supervisor."
  }
 ],
