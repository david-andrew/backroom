 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-09-24",
   "text": "No Money Bail Act of 2019 This bill restricts the use of money bail (i.e., the payment of money as a condition of pretrial release) in criminal cases. Specifically, it prohibits the use of money bail in federal criminal cases. Additionally, it makes a state that uses a money bail system ineligible for funds under the Edward Byrne Memorial Justice Assistance Grant Program."
  }
 ],
