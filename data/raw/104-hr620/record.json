 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1995-01-20",
   "text": "Income Equity Act of 1995 - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage from $4.25 to $6.50 an hour. Amends the Internal Revenue Code to deny employers a deduction for payments of excessive compensation (more than 25 times the lowest compensation paid any other employee)."
  }
