 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2014-03-27",
   "text": "Foreclosure Fairness Act of 2014 - Prohibits a court, in the case of any federally related mortgage loan made after enactment of this Act, from entering a deficiency judgment requiring the mortgagor to pay any balance on the mortgage loan after a foreclosure sale of the mortgaged property."
  }
