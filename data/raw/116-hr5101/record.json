 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-11-14",
   "text": "Superfund Polluter Pays Act\n This bill reinstates and extends the Hazardous Substance Superfund Financing rate through 2023 and increases the rate to 16.3 cents a barrel, adjusted for inflation beginning after 2019. \n The bill imposes on corporations a 0.12% tax of the excess of the modified environmental tax taxable income of the corporation over $3.13 million."
  }
 ],
