 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2000-09-27",
   "text": "Death Tax Relief Now Act of 2000 - Amends the Internal Revenue Code to: (1) reduce the estate tax rates; (2) increase (and provide a cost of living adjustment for) the exemption equivalent of the unified credit; (3) repeal the family-owned business interests deduction provisions; (4) repeal provisions providing for a credit for State death taxes and provide for the deduction from an estate's value of State death taxes paid; and (5) increase the permissible number of partners or shareholders in a closely held business for purposes of eligibility for an extension of estate tax payments."
  }
 ],
