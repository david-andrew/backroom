 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1990-01-23",
   "text": "Amends the Internal Revenue Code to impose a 90-percent excise tax on the windfall profit from home heating oil sold by the producer or importer, who shall pay the tax. Establishes the Home Heating Oil Trust Fund and appropriates to it the excise taxes received from home heating oil windfall profits. Makes amounts in such Fund available for grants under the Low-Income Home Energy Assistance Act of 1981."
  }
 ],
