 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1989-04-05",
   "text": "Amends the Internal Revenue Code to impose a three percent excise tax on wholesale sales of paper and paper products that do not contain the minimum amount of recycled materials in accordance with Environmental Protection Agency (EPA) guidelines. Increases the tax rate by one percent each year to reach a maximum 12 percent rate for sales during 2000 and thereafter. Directs the EPA Administrator to issue guidelines for products not already designated by relevant guidelines."
  }
 ],
