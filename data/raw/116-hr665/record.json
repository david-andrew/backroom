 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-01-17",
   "text": "Save Oak Flat Act\n This bill repeals the requirement for the Department of Agriculture to convey 2,422 acres of Forest Service land located in Pinal County, Arizona, to Resolution Copper Mining, LLC, in exchange for various parcels of land owned by Resolution Copper."
  }
