 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2019-07-30",
   "text": "Equity in Compensation Act\n This bill imposes an additional tax on the income of corporations that have gross revenues in excess of $1 billion and a wage disparity level in excess of 3,000%. A \"wage disparity level\" is defined as the ratio of the annual salary of the highest compensated officer of the corporation to the median annual salary of all employees of the corporation."
  }
