 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2015-03-03",
   "text": "Internet Freedom Act\n Nullifies the rule adopted by the Federal Communications Commission (FCC) on February 26, 2015, relating to the reclassification of broadband Internet access service as a telecommunications service. \n Prohibits the FCC from reissuing such rule in substantially the same form, or from issuing a new rule that is substantially the same, unless the rule is specifically authorized by a law enacted after enactment of this Act.\n Exempts any rule that the FCC determines is necessary for national security, public safety, or assistance to law enforcement."
  }
 ],
