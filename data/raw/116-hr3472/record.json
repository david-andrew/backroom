 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-06-25",
   "text": "College for All Act of 2019\n This bill provides funding for (1) grants to eliminate tuition and required fees for eligible students at community colleges, public four-year institutions of higher education, and tribal colleges and universities; and (2) grants to eliminate or significantly reduce tuition and required fees for eligible students at private, nonprofit historically Black colleges and universities and minority-serving institutions."
  }
