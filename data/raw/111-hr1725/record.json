 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-03-25",
   "text": "Voluntary State Discount Prescription Drug Plan Act of 2009 - Amends title XIX (Medicaid) of the Social Security Act to require drug manufacturers to pay rebates to state prescription drug discount programs as a condition of participating in a Medicaid rebate agreement for outpatient prescription drugs, but only if the state has elected to establish an optional state prescription drug discount program."
  }
