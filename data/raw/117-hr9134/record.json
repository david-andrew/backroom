 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2022-10-04",
   "text": "No PAC Act\n This bill bars a candidate for Senator, Representative, Delegate, or Resident Commissioner from accepting an election contribution from any political committee other than an authorized committee of the candidate.\n Such a candidate may not establish a leadership Political Action Committee (PAC)."
  }
