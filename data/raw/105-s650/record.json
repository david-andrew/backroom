 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1997-04-24",
   "text": "Estate Tax Reduction Act of 1997 - Amends the Internal Revenue Code to reduce the rate of the estate tax to the following: (1) 20 percent on estates not over $10 million; and (2) $2 million, plus 30 percent of the excess over $10 million on estates over $10 million. Increases the unified credit against the estate tax and the gift tax."
  }
 ],
