 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-07-22",
   "text": "Medicare Dental Coverage Act of 2021\n This bill expands Medicare coverage to include dentures and dental and oral health services, in accordance with specified limitations. Covered services include basic and major treatments (as determined by the Centers for Medicare & Medicaid Services) as well as specified preventive and screening services."
  }
