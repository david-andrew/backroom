 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-01-08",
   "text": "Economic Growth Through Tax Stimulus Act of 2009 - Makes permanent: (1) the tax provisions of the Economic Growth and Tax Relief Reconciliation Act of 2001; (2) the reduction in dividend and capital gain tax rates in the Jobs and Growth Tax Relief Reconciliation Act of 2003; (3) the tax deduction for state and local sales taxes; (4) the tax deduction for tuition and related expenses; and (5) the increased expensing allowance for depreciable business assets. \nAmends the Internal Revenue Code to reduce individual and corporate income tax rates in taxable years between 2008 and 2014."
  }
 ],
