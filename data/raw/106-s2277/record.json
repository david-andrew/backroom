 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2000-03-23",
   "text": "Authorizes the President to extend nondiscriminatory treatment (normal trade relations treatment) to the products of China, provided, prior to such determination, the President certifies to Congress that the terms and conditions for China's accession to the World Trade Organization are at least equivalent to those agreed between the United States and China on November 15, 1999."
  }
 ],
