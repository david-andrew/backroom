 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1991-11-26",
   "text": "Health Care Protection Act - Amends the Internal Revenue Code to impose an excise tax on: (1) a group health plan that denies, limits, or conditions the coverage of an individual based on health status, claims experience, receipt of health care, medical history, or lack of evidence of insurability; and (2) any person who has provided coverage to an individual and fails to disclose such coverage to a group health plan that requests such information."
  }
 ],
