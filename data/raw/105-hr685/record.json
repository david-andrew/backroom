 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1997-02-11",
   "text": "Fair Wage Act of 1997 - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage rate to: (1) $5.50 an hour during the year beginning July 1, 1998; (2) $6.00 an hour during the year beginning July 1, 1999; and (3) $6.50 an hour beginning July 1, 2000."
  }
