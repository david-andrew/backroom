 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-12-18",
   "text": "American Renewable Energy and Efficiency Act\n This bill requires (1) electric utilities to obtain a minimum percentage of the electricity they sell in 2021 through 2039 from renewable resources, and (2) electric utilities and natural gas utilities to meet performance standards for 2021 through 2030 with respect to cumulative electricity savings and cumulative natural gas savings."
  }
