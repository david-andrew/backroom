 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-10-11",
   "text": "Affordable Pricing for Taxpayer-Funded Prescription Drugs Act of 2019\n This bill prohibits federal agencies and nonprofit entities that conduct federally funded health care research from providing a patent for a drug based on such research until the entity receiving the patent enters into a reasonable pricing agreement with the Department of Health and Human Services."
  }
