 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-01-26",
   "text": "Medicare Prescription Drug Savings and Choice Act of 2009 - Amends part D (Voluntary Prescription Drug Benefit Program) of title XVIII (Medicare) of the Social Security Act to provide for: (1) establishment of one or more Medicare operated prescription drug plan options; and (2) an appeals process for denials of benefits under a Medicare operated prescription drug plan."
  }
 ],
