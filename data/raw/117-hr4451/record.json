 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-07-16",
   "text": "Securities Clarity Act \n This bill excludes an investment contract asset as being considered a security, including for disclosure and registration purposes. An investment contract asset as defined by the bill is a tangible or intangible asset sold pursuant to an investment contract that is not otherwise considered a security."
  }
