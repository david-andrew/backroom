 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-12-17",
   "text": "Jones Act Repeal Act \n This bill repeals coastwise laws, commonly known as the Jones Act, that govern domestic transportation of merchandise or passengers by vessels. The Jones Act requires that vessels transporting merchandise or passengers between Puerto Rico and other U.S. ports be built in the United States, be at least 75% owned by U.S. citizens, and be mostly crewed by U.S. citizens."
  }
 ],
