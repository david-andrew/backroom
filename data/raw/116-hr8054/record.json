 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2020-08-14",
   "text": "Support Children Having Open Opportunities for Learning Act of 2020 or the SCHOOL Act of 2020\n This bill allows certain federal funds for elementary and secondary education to follow the student to the school that they attend (i.e., public, private, or home school), regardless of whether the student is learning in person or remotely. Such funds may be used for educational and instructional materials, tutoring, tuition for private school, and extracurricular activities."
  }
 ],
