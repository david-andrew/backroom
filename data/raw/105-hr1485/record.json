 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1997-04-29",
   "text": "Tipped Wage Parity Act - Declares that the requirements of the Fair Labor Standards Act of 1938 relating to the accounting of tips in determining the wage of tipped employees preempts any State or local law, ordinance, regulation, or order precluding a tip credit or requiring a tip credit less than the tip credit permitted under such Act."
  }
