 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2013-06-20",
   "text": "Amends the Consumer Product Safety Act to remove from the definition of \"consumer product\" the exclusion for any article sold by a manufacturer, producer, or importer that would be subject to a firearms sales tax under the Internal Revenue Code for pistols, revolvers, and other firearms, including shells and cartridges, thereby permitting the Consumer Product Safety Commission (CPSC) to issue safety standards for such articles."
  }
