 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2019-02-05",
   "text": "Taking Account of Bureaucrats' Spending Act of 2019 or the TABS Act of 2019\n This bill eliminates provisions in the Consumer Financial Protection Act of 2010 that fund the Consumer Financial Protection Bureau (CFPB) using transfers from the earnings of the Federal Reserve System. The transfers under current law permit the CFPB to be funded outside of the annual appropriations process, and this bill brings the CFPB into the regular process."
  }
 ],
