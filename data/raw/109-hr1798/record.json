 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2005-04-21",
   "text": "Clean Ocean and Safe Tourism Anti-Drilling Act, or the COAST Anti-Drilling Act - Amends the Outer Continental Shelf Lands Act to prohibit the Secretary of the Interior from issuing a lease for the exploration, development, or production of oil, natural gas, or any other mineral in either the Mid-Atlantic or the North Atlantic planning areas."
  }
 ],
