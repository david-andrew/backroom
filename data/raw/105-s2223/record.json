 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "1998-06-25",
   "text": "Mortgage Litigation Reform Act of 1998 - Amends the Real Estate Settlement Procedures Act of 1974 to provide a moratorium between the date of enactment of this Act and July 1, 1999, on class certification orders, discovery, sanctions, or other proceedings with regard to civil actions alleging improper payments by one lender to another lender or mortgage broker."
  }
