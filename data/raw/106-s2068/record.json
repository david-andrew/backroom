 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2000-02-10",
   "text": "Radio Broadcasting Preservation Act of 2000 - Prohibits the Federal Communications Commission from prescribing any rules authorizing the operation of new, low power FM radio stations, or establishing a low power radio service, as currently proposed.Terminates previously prescribed rules which would violate such prohibition and voids licenses issued pursuant to such rules."
  }
