   "actionTime": "14:05:38",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "DEBATE - The House proceeded with forty minutes of debate on H.R. 2749.",
   "type": "Floor"
  },
  {
   "actionCode": "H30000",
   "actionDate": "2009-07-29",
   "actionTime": "14:05:37",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "Considered under suspension of the rules. (consideration: CR H8990-9016)",
   "type": "Floor"
  },
  {
