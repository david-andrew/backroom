 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2009-02-13",
   "text": "Let Wall Street Pay for Wall Street's Bailout Act of 2009 - Amends the Internal Revenue Code to require securities trading facilities to pay an excise tax on a specified percentage of the value of securities and commodities transactions sufficient to recoup the net cost of carrying out the Troubled Asset Relief Program (TARP) of the Emergency Economic Stabilization Act of 2008."
  }
