   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "DEBATE - Pursuant to the provisions of H. Res. 394, the Committee of the Whole proceeded with forty minutes of debate on the Shuster amendment.",
   "type": "Floor"
  },
  {
   "actionCode": "H8D000",
