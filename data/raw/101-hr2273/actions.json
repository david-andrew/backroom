  },
  {
   "actionCode": "H8D000",
   "actionDate": "1990-05-17",
   "actionTime": "17:45:49",
   "sourceSystem": {
    "code": 2,
    "name": "House floor actions"
   },
   "text": "DEBATE - Pursuant to the provisions of H. Res. 394, the Committee of the Whole is proceeding with thirty minutes of debate on the Chapman amendment.",
   "type": "Floor"
  },
  {
   "actionCode": "H8D000",
