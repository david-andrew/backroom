 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2021-06-28",
   "text": "Restore the Rights of Property Owners under the Eviction Moratorium Issued by the CDC Act of 2021\n This bill nullifies beginning on July 1, 2021, the emergency order (and any extensions of the order) issued by the Centers for Disease Control and Prevention on September 4, 2020, that restricted residential evictions during the COVID-19 emergency. It also prohibits the order from being reissued unless specifically authorized by law."
  }
 ],
