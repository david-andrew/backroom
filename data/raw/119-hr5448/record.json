 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2025-09-18",
   "text": "Protecting Free Vaccines Act\nThis bill requires Medicare, Medicaid, the Children's Health Insurance Program (CHIP), and private health insurers to cover, without cost-sharing, vaccines that were recommended by the Centers for Disease Control and Prevention's Advisory Committee on Immunization Practices as of October 25, 2024. The requirement ends on January 1, 2030."
  }
 ],
