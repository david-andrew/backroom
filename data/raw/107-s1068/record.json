 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2001-06-20",
   "text": "Electricity Gouging Relief Act of 2001 - Amends the Federal Power Act to instruct the Federal Energy Regulatory Commission to order a refund (including interest) for the portion of charges on the transmission or sale of electric energy between June 1, 2000, and June 19, 2001, which the Commission deems to be unjust and unreasonable."
  }
