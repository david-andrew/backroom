 "summaries": [
  {
   "version": "Introduced in House",
   "date": "1996-04-17",
   "text": "Minimum Wage Increase Act of 1996 - Amends the Fair Labor Standards Act of 1938 to increase the minimum wage rate under such Act from the current $4.25 per hour to: (1) $4.75 per hour for one year beginning 90 days after enactment of this Act; and (2) $5.25 per hour after that year."
  }
