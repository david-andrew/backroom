 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2014-05-14",
   "text": "Let Seniors Work Act of 2014 - Amends title II (Old Age, Survivors and Disability Insurance) (OASDI) of the Social Security Act to: (1) eliminate the payroll tax for individuals who have attained retirement age, and (2) remove the limitation on the amount of outside income which a beneficiary may earn (earnings test) without incurring a reduction in benefits."
  }
 ],
