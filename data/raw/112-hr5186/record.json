 "summaries": [
  {
   "version": "Introduced in House",
   "date": "2012-04-27",
   "text": "Halt Index Trading of Energy Commodities (HITEC) Act - Amends the Commodity Exchange Act to declare unlawful for: (1) a commodity index fund to engage in an energy commodity transaction if any person investing in the fund is an excluded investor, (2) an energy commodity index fund to accept an investment from a person who is an excluded investor, or (3) a commodity index fund to hold an investment in an energy commodity if any person investing in the fund is an excluded investor.\n Defines \"excluded investor\" as a person with respect to whom there is no position in an energy commodity which, if held by the person, would be considered a bona fide hedging position."
  }
 ],
