 "summaries": [
  {
   "version": "Introduced in Senate",
   "date": "2003-07-17",
   "text": "Commonsense Consumption Act of 2003 - Declares that a qualified civil liability action may not be brought in any Federal or State court, and that any pending qualified civil liability action shall be dismissed immediately by the relevant court. Defines a qualified civil liability action as a civil action brought by any person against a manufacturer or seller of a food, or a trade association, for damages or injunctive relief based on a claim of injury resulting from weight gain or obesity. Specifies actions which shall not count as qualified civil liability actions, including an action regarding the sale of a food which is adulterated."
  }
 ],
